+++ b/verl/verl/utils/torch_functional.py
@@ -160,6 +160,45 @@ def entropy_from_logits_with_chunking(logits: torch.Tensor, chunk_size: int = 20
     return entropy
 
 
+def entropy_from_logits_by_position_chunks(logits: torch.Tensor, chunk_size: int = 512) -> torch.Tensor:
+    """Exact entropy from (batch, positions, vocab) or (positions, vocab) logits
+    without ever materializing a full (positions, vocab) fp32 probability tensor.
+
+    Why this exists: `entropy_from_logits` runs `F.softmax(logits)` in one shot.
+    Under bf16 autocast, softmax/logsumexp are upcast to fp32, so for a
+    (40, 3072, 151936) micro-batch that single call tries to allocate
