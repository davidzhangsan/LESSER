index 0000000..905a831
--- /dev/null
+++ b/select/parallel/prod_feature.py
@@ -0,0 +1,234 @@
+"""
+PROD: sketched forward-only last-layer (lm_head) policy-gradient features.
+
+Math
+----
+The analyzer's per-mini-batch loss (grpo_grad_analyze_parallel.py) is
+
+    L_mb = 8 * ( - sum_t adv_i(t) * ratio_t * mask_t ) / sum_{t in mb} mask_t,
+
+with ratio_t = exp(logpi_t - detach(logpi_t)) = 1 (old_log_probs are detached),
+so the accumulated lm_head.weight gradient over a dataset D is exactly
+
+    G(D) = sum_mb sum_t w_t * (softmax(logits_t) - onehot(y_t)) (x) h_t,
+    w_t  = 8 * adv_i(t) * mask_t / sum_{t' in mb} mask_{t'},
+
+where y_t is the rollout token at shifted position t, h_t is the last hidden
+state (post final norm) that PRODUCES logits_t, and mask is the analyzer's
+effective response mask: the stored (already shifted) response_mask with its
+first column dropped (the analyzer applies new_log_probs[..., 1:] and
+response_mask[..., 1:]); we replicate that by zeroing column 0.
+
+PROD sketches G with a two-sided Rademacher sketch:
+
+    F(D) = R_v^T G(D) R_h  in R^{d1 x d2},  flattened to d1*d2 = 8192,
+    R_v in {+-1/sqrt(d1)}^{V x d1}  (vocab side,  d1 = 64),
+    R_h in {+-1/sqrt(d2)}^{H x d2}  (hidden side, d2 = 128),
+
+built once from a torch CPU generator with seed 0 (R_v is drawn FIRST, then
+R_h, from the same generator; changing the draw order changes the sketch) and
+cached on device. E[R_v R_v^T] = I_V and E[R_h R_h^T] = I_H, so
+E[<F1, F2>] = <G1, G2> and cosine(F1, F2) ~= cosine(G1, G2) up to JL noise.
+
+Everything is forward-only (torch.no_grad). softmax @ R_v is computed in fp32
+chunks of <= 512 response tokens to avoid materializing a (B, T, V) fp32
+tensor; this follows the commented chunked-lm_head template in
+select/parallel/grpo_loss.py (lines ~144-220).
+
+Divergence from that template: the code
+reuses the logits produced by the model forward instead of re-projecting
+hidden @ lm_head.weight.T, because under FSDP the lm_head weight is sharded
+outside forward and not directly accessible. The numerics are identical since
+outputs.logits == lm_head(outputs.hidden_states[-1]).
+"""
+
+import math
+from typing import Dict, List
+
+import torch
+
+from grpo_utils import collate_batch
+
+# Feature mode. Without GRADALIGN_PROD_SKETCH the score is the EXACT output-layer
+# block of the analyzer's gradient, G(D) in R^{V x H} as written above, compared by
+# cosine with no random projection. GRADALIGN_PROD_SKETCH=1 selects the two-sided
+# Rademacher sketch F(D) (64 x 128 entries), which the LESSER recipes use.
+import os
+PROD_USE_SKETCH = os.environ.get("GRADALIGN_PROD_SKETCH", "0") == "1"
+
+# Sketch hyperparameters (fixed; part of the PROD definition).
+PROD_D_VOCAB = 64      # d1: vocab-side sketch dimension
+PROD_D_HIDDEN = 128    # d2: hidden-side sketch dimension
+PROD_SKETCH_SEED = 0   # torch CPU generator seed
+PROD_TOKEN_CHUNK = 512  # max response tokens whose fp32 softmax is materialized at once
+
+
+class ProdSketch:
+    """Two-sided Rademacher sketch matrices, built once and cached on device."""
+
+    def __init__(
+        self,
+        vocab_size: int,
+        hidden_size: int,
+        device: torch.device,
+        d_vocab: int = PROD_D_VOCAB,
+        d_hidden: int = PROD_D_HIDDEN,
+        seed: int = PROD_SKETCH_SEED,
+    ):
+        if vocab_size <= 0 or hidden_size <= 0:
+            raise ValueError(
+                f"ProdSketch needs positive dims, got vocab_size={vocab_size}, hidden_size={hidden_size}"
+            )
+        self.vocab_size = vocab_size
+        self.hidden_size = hidden_size
+        self.d_vocab = d_vocab
+        self.d_hidden = d_hidden
+        self.seed = seed
+        self.exact = not PROD_USE_SKETCH
+        if self.exact:
+            # Exact mode: the feature is the dense (V, H) gradient block itself.
+            self.feature_dim = vocab_size * hidden_size
+            self.R_v = None
+            self.R_h = None
+            return
+        self.feature_dim = d_vocab * d_hidden
+
+        gen = torch.Generator(device="cpu")
+        gen.manual_seed(seed)
+        # Draw order matters for reproducibility: R_v FIRST, then R_h.
+        rv_bits = torch.randint(0, 2, (vocab_size, d_vocab), generator=gen, dtype=torch.int8)
+        rh_bits = torch.randint(0, 2, (hidden_size, d_hidden), generator=gen, dtype=torch.int8)
+        self.R_v = ((rv_bits.to(torch.float32) * 2.0) - 1.0) / math.sqrt(d_vocab)
+        self.R_h = ((rh_bits.to(torch.float32) * 2.0) - 1.0) / math.sqrt(d_hidden)
+        self.R_v = self.R_v.to(device)
+        self.R_h = self.R_h.to(device)
+
+
+def l2_normalize_feature(feat: torch.Tensor) -> torch.Tensor:
+    """L2-normalize a PROD feature.
+
+    Mirrors the gradient path's convention (norm + 1e-5 in the denominator,
+    see compute_loss_and_gradients_distributed), so an exactly-zero feature
+    stays exactly zero and its dot with anything is 0.0.
+    """
+    return feat / (feat.norm() + 1e-5)
+
+
+def _accumulate_prod_tokens_(feat: torch.Tensor, hidden: torch.Tensor,
+                             logits: torch.Tensor, labels: torch.Tensor,
+                             weights: torch.Tensor, sketch: ProdSketch) -> None:
+    """Accumulate response-token contributions into an explicit output buffer."""
+    probs = torch.softmax(logits.to(torch.float32), dim=-1)
+    if sketch.exact:
+        probs[torch.arange(len(labels), device=labels.device), labels] -= 1.0
+        feat += (probs * weights.unsqueeze(-1)).T @ hidden.to(torch.float32)
+    else:
+        r_proj = probs @ sketch.R_v - sketch.R_v[labels]
+        h_proj = hidden.to(torch.float32) @ sketch.R_h
+        feat += (r_proj * weights.unsqueeze(-1)).T @ h_proj
+
+
+@torch.no_grad()
+def compute_prod_feature_distributed(
+    model: torch.nn.Module,
+    accelerator,
+    batch_data: List[Dict[str, torch.Tensor]],
+    mini_batch_size: int,
+    sketch: ProdSketch,
+    pad_token_id: int,
+    token_chunk_size: int = PROD_TOKEN_CHUNK,
+) -> torch.Tensor:
+    """Compute the last-layer policy-gradient feature (G(D) or its sketch F(D)) for a dataset shard.
+
+    Handles advantages / response_mask exactly like the gradient path
+    (compute_loss_and_gradients_distributed): the same mini-batching, the same
+    per-mini-batch mask normalization, the same x8 constant, and the same extra
+    [..., 1:] shift of the stored response mask.
+
+    Each rank passes its LOCAL shard; the returned feature is all-reduce SUMMED
+    across ranks (the gradient path's FSDP mean-reduction differs only by a
+    constant 1/world_size, which cancels in cosine similarity). Returned
+    feature is the raw (unnormalized) flattened Tensor[d1*d2] (sketch) or
+    Tensor[V*H] (exact) in fp32 on accelerator.device. A dataset whose weights are all zero (e.g. a
+    zero-advantage group) yields an EXACTLY-zero feature.
+    """
+    device = accelerator.device
+    if sketch.exact:
+        feat = torch.zeros(sketch.vocab_size, sketch.hidden_size, device=device, dtype=torch.float32)
+    else:
+        feat = torch.zeros(sketch.d_vocab, sketch.d_hidden, device=device, dtype=torch.float32)
+
+    for i in range(0, len(batch_data), mini_batch_size):
+        mini_batch = batch_data[i : i + mini_batch_size]
+        for item in mini_batch:
+            if "advantages" not in item:
+                raise KeyError(
+                    "PROD: batch entry missing 'advantages'; refusing to default it "
+                    "(entries must be prepared like the gradient path)"
+                )
+        padded = collate_batch(mini_batch, pad_token_id)
+
+        input_ids = padded["input_ids"].to(device)              # (B, L)
+        attention_mask = padded["attention_mask"].to(device)    # (B, L)
+        response_mask = padded["response_mask"].to(device)      # (B, L-1), already shifted
+        advantages = padded["advantages"].to(device=device, dtype=torch.float32)  # (B,)
+
+        B, L = input_ids.shape
+        if response_mask.shape != (B, L - 1):
+            raise ValueError(
+                f"PROD: expected shifted response_mask of shape {(B, L - 1)}, got {tuple(response_mask.shape)}"
+            )
+        if L < 2 or response_mask.shape[1] == 0:
+            continue
+
+        # Replicate the analyzer's extra shift (new_log_probs[..., 1:] /
+        # response_mask[..., 1:]) by zeroing column 0: identical loss terms and
+        # identical normalization constant sum(mask[..., 1:]).
+        mask = response_mask.to(torch.float32).clone()
+        mask[:, 0] = 0.0
+        mask_sum = mask.sum()
+        if mask_sum.item() <= 0:
+            continue
+
+        # w_t = 8 * adv_i * mask_t / sum(mask) with the mini-batch-local denominator,
+        # exactly like compute_policy_loss (per-mini-batch normalization) * 8.
+        weights = (8.0 * advantages.unsqueeze(-1) * mask) / mask_sum  # (B, L-1)
+        if not torch.any(weights != 0):
+            continue
+
+        outputs = model(
+            input_ids=input_ids,
+            attention_mask=attention_mask,
+            output_hidden_states=True,
+            use_cache=False,
+        )
+        hidden = outputs.hidden_states[-1]  # (B, L, H), post final norm: produces the logits
+        logits = outputs.logits             # (B, L, V)
+        H = hidden.shape[-1]
+        V = logits.shape[-1]
+        if V != sketch.vocab_size or H != sketch.hidden_size:
+            raise ValueError(
+                f"PROD: sketch dims (V={sketch.vocab_size}, H={sketch.hidden_size}) do not match "
+                f"model outputs (V={V}, H={H})"
+            )
+
+        # Position alignment: hidden[:, t, :] produces logits[:, t, :] which score
+        # label input_ids[:, t+1]; the shifted mask column t refers to that label.
+        h_flat = hidden[:, :-1, :].reshape(-1, H)        # (B*(L-1), H)
+        logit_flat = logits[:, :-1, :].reshape(-1, V)    # (B*(L-1), V)
+        labels_flat = input_ids[:, 1:].reshape(-1)       # (B*(L-1),)
+        w_flat = weights.reshape(-1)                     # (B*(L-1),)
+
+        nz = torch.nonzero(w_flat, as_tuple=False).squeeze(-1)
+        if nz.numel() == 0:
+            continue
+
+        # Chunk the fp32 softmax over response tokens to avoid a (B, T, V) fp32 tensor.
+        for s in range(0, nz.numel(), token_chunk_size):
+            idx = nz[s : s + token_chunk_size]
+            _accumulate_prod_tokens_(feat, h_flat[idx], logit_flat[idx],
+                                     labels_flat[idx], w_flat[idx], sketch)
+
+    # All ranks must reach this collective even with empty local shards.
+    feat = accelerator.reduce(feat, reduction="sum")
+    return feat.reshape(-1)
