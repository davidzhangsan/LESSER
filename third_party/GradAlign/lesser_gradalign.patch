+def wait_for_host_ram(min_avail_gb=None, timeout_s=21600, poll_s=60):
+    import os
+    if min_avail_gb is None:
+        min_avail_gb = float(os.environ.get("GRADALIGN_MIN_AVAIL_GB", "32"))
+    if min_avail_gb <= 0:
+        print("[launch_verl] RAM gate disabled (GRADALIGN_MIN_AVAIL_GB<=0)", flush=True)
+        return
+    # Delay the verl launch until the host has min_avail_gb GiB of available memory
+    # (GRADALIGN_MIN_AVAIL_GB, default 32; 0 disables), which avoids out-of-memory kills
+    # by Ray on hosts shared with other jobs. After timeout_s the launch proceeds anyway.
+    import time
+    t0 = time.time()
+    while time.time() - t0 < timeout_s:
+        avail_kb = int(next(l for l in open("/proc/meminfo") if l.startswith("MemAvailable")).split()[1])
+        if avail_kb / 1048576.0 >= min_avail_gb:
+            print(f"[launch_verl] RAM gate pass: {avail_kb/1048576.0:.1f} GiB available", flush=True)
+            return
+        print(f"[launch_verl] RAM gate: {avail_kb/1048576.0:.1f} GiB available < {min_avail_gb} GiB; waiting {poll_s}s", flush=True)
+        time.sleep(poll_s)
+    print("[launch_verl] RAM gate timeout; launching anyway", flush=True)
+
