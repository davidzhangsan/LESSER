@@ -0,0 +1,36 @@
+"""Verl-compatible reward for the mixed Countdown/WebInstruct/DAPO pool.
+
+Countdown items carry the full problem statement in reward_model.ground_truth (the
+repo's shipped countdown_judge parses nums and target from any string containing the
+problem template), so this wrapper can route them to judge_countdown. All other items
+use the repo's default rule path (last boxed + is_equiv), identical to math_reward's
+rule branch, with no model-judge API dependency.
+"""
+from verl.utils.reward_score.countdown_judge import judge_countdown
+from verl.utils.reward_score.math_reward import last_boxed_only_string, remove_boxed, is_equiv
+
+
+def compute_score(data_source=None, solution_str=None, ground_truth=None,
+                  extra_info=None, task=None, **kwargs) -> float:
+    """Sync, keyword-friendly: matches the naive manager's call
+    compute_score(data_source=..., solution_str=..., ground_truth=..., extra_info=...)
+    and tolerates the prime manager's positional (task, completion, reference, info)."""
+    src = data_source if data_source is not None else task
+    if solution_str is None:  # prime-style positional: (task, completion, reference, info)
+        src, solution_str, ground_truth, extra_info = data_source, task, ground_truth, extra_info
+    if "countdown" in str(src):
+        # The judge evaluates the model's equation string and can raise on malformed
+        # expressions (e.g. TypeError from a tuple-valued expression), which verl treats as
+        # fatal. An equation the judge cannot evaluate is incorrect: score 0.
+        try:
+            ok, _reason = judge_countdown(str(ground_truth), str(solution_str))
+        except Exception:
+            return 0.0
+        return 1.0 if ok else 0.0
+    try:
+        boxed = last_boxed_only_string(solution_str)
+        if boxed is not None and is_equiv(remove_boxed(boxed), str(ground_truth)):
+            return 1.0
+    except Exception:
+        pass
+    return 0.0
