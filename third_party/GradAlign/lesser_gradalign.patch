+def _run_with_retries(cmd, check=True):
+    """Retry a failed stage instead of aborting the run.
+    GRADALIGN_MAX_RETRIES (default 0) keeps the released behavior. Before a retry the GPUs
+    are drained (_kill_other_pythons), and verl resumes from its last saved checkpoint
+    (trainer.resume_mode=auto)."""
+    max_retries = int(os.environ.get("GRADALIGN_MAX_RETRIES", "0"))
+    for attempt in range(max_retries + 1):
+        try:
+            return subprocess.run(cmd, check=check)
+        except subprocess.CalledProcessError as e:
+            if attempt >= max_retries:
+                raise
+            print(f"[dynamic_selection] stage failed (exit {e.returncode}), attempt {attempt + 1}/{max_retries + 1}; "
+                  f"retrying in 60 s: {' '.join(cmd[:4])} ...", flush=True)
+            _kill_other_pythons()
+            time.sleep(60)
