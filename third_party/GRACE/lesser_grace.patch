+def compute_prod_features(logits: torch.Tensor, hidden: torch.Tensor, labels: torch.Tensor,
+                          s_r: torch.Tensor = None, s_h: torch.Tensor = None,
+                          ignore_index: int = IGNORE_INDEX,
+                          chunk_size: int = PROD_CHUNK_TOKENS):
+    """Return (G, g2s, n_sup) over supervised shifted positions, in fp32.
+
+    logits: (1, T, V) — pre-softmax lm_head outputs.
+    hidden: (1, T, d) — outputs.hidden_states[-1] (post-final-norm; feeds lm_head).
+    labels: (1, T)    — with ignore_index on non-supervised positions.
+
+    Shift convention matches HF causal-LM loss: logits[:, :-1] predict labels[:, 1:].
+    r_t = softmax(logits_t) - onehot(label_t); h_t is the hidden state at the SAME
+    position as logits_t.
+
+    G = (1/n_sup) * R^T H is EXACT, but accumulated in time chunks of at most
+    `chunk_size` supervised tokens so a full (T, V) fp32 softmax matrix is never
+    materialized alongside the model's own logits (avoids OOM on 24GB GPUs). Peak
+    extra memory: G (V, d) plus one (chunk_size, V) softmax block.
+
+    If s_r/s_h are given, also accumulates the two-sided sketch
+    g2s = (R S_r)^T (H S_h) / n_sup, shape (32, 16); otherwise g2s is None.
+    """
+    if logits.dim() != 3 or hidden.dim() != 3 or labels.dim() != 2:
+        raise ValueError(
+            f"Unexpected shapes: logits {tuple(logits.shape)}, hidden {tuple(hidden.shape)}, "
+            f"labels {tuple(labels.shape)}"
+        )
+    if logits.shape[0] != 1:
+        raise ValueError(f"prod feature assumes batch size 1, got {logits.shape[0]}")
+    if logits.shape[1] != hidden.shape[1] or logits.shape[1] != labels.shape[1]:
+        raise ValueError("logits/hidden/labels sequence lengths disagree")
+    if (s_r is None) != (s_h is None):
+        raise ValueError("s_r and s_h must be given together (or both omitted).")
+    if chunk_size <= 0:
+        raise ValueError(f"chunk_size must be positive, got {chunk_size}")
+
+    shift_logits = logits[0, :-1]
+    shift_hidden = hidden[0, :-1]
+    shift_labels = labels[0, 1:]
+
+    mask = shift_labels != ignore_index
+    sup_idx = mask.nonzero(as_tuple=True)[0]
+    n_sup = int(sup_idx.numel())
+    if n_sup == 0:
+        raise RuntimeError("Example has zero supervised positions (all labels == ignore_index).")
+
+    vocab_size = shift_logits.shape[-1]
+    hidden_dim = shift_hidden.shape[-1]
+    G = torch.zeros(vocab_size, hidden_dim, dtype=torch.float32, device=logits.device)
+    g2s = None
+    if s_r is not None:
+        g2s = torch.zeros(s_r.shape[1], s_h.shape[1], dtype=torch.float32, device=logits.device)
+
+    for start in range(0, n_sup, chunk_size):
+        idx = sup_idx[start:start + chunk_size]
+        r_c = torch.softmax(shift_logits[idx].float(), dim=-1)  # (c, V) fp32, c <= chunk_size
+        y_c = shift_labels[idx]
+        r_c[torch.arange(idx.numel(), device=r_c.device), y_c] -= 1.0
+        h_c = shift_hidden[idx].float()  # (c, d) fp32
+        G.addmm_(r_c.t(), h_c)
+        if g2s is not None:
+            g2s.addmm_((r_c @ s_r).t(), h_c @ s_h)
+        del r_c, h_c, y_c, idx
+
+    G /= n_sup
+    if g2s is not None:
+        g2s /= n_sup
+    return G, g2s, n_sup
+
+
+def compute_prod_G(logits: torch.Tensor, hidden: torch.Tensor, labels: torch.Tensor,
+                   ignore_index: int = IGNORE_INDEX) -> torch.Tensor:
+    """Exact output-readout gradient of mean CE: ``R.T @ H / n_sup``.
+
+    This equals the ``lm_head.weight`` parameter-block gradient when that weight
+    is untied. For tied weights, the total parameter gradient additionally has
+    the input-embedding contribution.
+    """
+    G, _, _ = compute_prod_features(logits, hidden, labels, ignore_index=ignore_index)
+    return G
+
+
+def supervised_token_count(labels: torch.Tensor, ignore_index: int = IGNORE_INDEX) -> int:
+    """Count labels used by HF causal-LM mean CE (labels shifted one token left)."""
+    if labels.dim() != 2 or labels.shape[0] != 1:
+        raise ValueError(f"Expected labels shape (1, T), got {tuple(labels.shape)}")
+    n_sup = int((labels[:, 1:] != ignore_index).sum().item())
+    if n_sup == 0:
+        raise RuntimeError("Example has zero supervised shifted positions.")
+    return n_sup
+
+
+def row_scale_from_n_sup(n_sup: int, mode: str = ROW_SCALE_NONE) -> float:
+    """Return a scalar row adapter without changing the feature direction."""
+    if n_sup <= 0:
+        raise ValueError(f"n_sup must be positive, got {n_sup}")
+    if mode == ROW_SCALE_NONE:
+        return 1.0
+    if mode == ROW_SCALE_GRACE_LOG_LENGTH:
+        if n_sup <= 1:
+            raise ValueError(
+                "grace_log_length would produce a zero row for n_sup <= 1"
+            )
+        return float(np.log(n_sup))
+    raise ValueError(f"Unsupported row-scale mode: {mode!r}")
+
+
+def build_two_sided_sketch(vocab_size: int, hidden_dim: int, device,
+                           r_dim: int = PROD2S_R_DIM, h_dim: int = PROD2S_H_DIM,
+                           seed: int = 0):
+    """Rademacher sketch matrices S_r (V, 32) and S_h (d, 16), drawn in that order
+    from a CPU torch.Generator seeded with `seed` (device-independent determinism)."""
+    gen = torch.Generator(device="cpu")
+    gen.manual_seed(seed)
+    s_r = torch.randint(0, 2, (vocab_size, r_dim), generator=gen, dtype=torch.int8)
+    s_h = torch.randint(0, 2, (hidden_dim, h_dim), generator=gen, dtype=torch.int8)
+    s_r = (s_r.float() * 2.0 - 1.0).to(device)
+    s_h = (s_h.float() * 2.0 - 1.0).to(device)
+    return s_r, s_h
+
+
+def build_prod_projector(model: torch.nn.Module, proj_dim: int, device):
+    """Projector + normalizer + two-sided sketch for the prod feature (shared by
+    main() and scripts/memory_probe_both.py so the probe exercises the real path)."""
+    lm_head = model.get_output_embeddings()
+    if lm_head is None or not hasattr(lm_head, "weight"):
+        raise RuntimeError("Model has no lm_head-style output embedding; prod feature unsupported.")
+    vocab_size, hidden_dim = lm_head.weight.shape
+    prod_grad_dim = int(vocab_size) * int(hidden_dim)
+    tied = bool(getattr(model.config, "tie_word_embeddings", False))
+    print(
+        f"prod: vocab_size={vocab_size}, hidden_dim={hidden_dim}, "
+        f"grad_dim={prod_grad_dim}, tied={tied}"
+    )
+    if tied:
+        print(
+            "prod: using the output-readout contribution; the shared parameter's "
+            "total gradient also includes the input-embedding path"
+        )
+    prod_projector = projectorcls(
+        proj_dim=int(proj_dim),
+        grad_dim=prod_grad_dim,
+        seed=0,
+        proj_type=ProjectionType.rademacher,
+        device=device,
+        dtype=torch.bfloat16,
+        block_size=4,
+        max_batch_size=8,
+    )
+    prod_normalize_factor = torch.sqrt(
+        torch.tensor(float(prod_grad_dim), dtype=torch.float32, device=device)
+    )
+    s_r, s_h = build_two_sided_sketch(vocab_size, hidden_dim, device=device, seed=0)
+    return prod_projector, prod_normalize_factor, s_r, s_h
+
+
+def compute_factor_means(logits, hidden, labels, ignore_index=IGNORE_INDEX,
+                         chunk_size=PROD_CHUNK_TOKENS):
+    """Chunked mean residual r_bar (V,) and mean hidden h_bar (d,) over
+    supervised shifted positions. Same shift/mask conventions as
+    compute_prod_features. Used by the ablation feature mode, which writes
+    h-only, residual-only, and pooled-factor control features (no paper result
+    uses this mode)."""
+    shift_logits = logits[0, :-1]
+    shift_hidden = hidden[0, :-1]
+    shift_labels = labels[0, 1:]
+    mask = shift_labels != ignore_index
+    sup_idx = mask.nonzero(as_tuple=True)[0]
+    n_sup = int(sup_idx.numel())
+    if n_sup == 0:
+        raise RuntimeError("Example has zero supervised positions.")
+    V = shift_logits.shape[-1]
+    d = shift_hidden.shape[-1]
+    r_bar = torch.zeros(V, dtype=torch.float32, device=logits.device)
+    h_bar = torch.zeros(d, dtype=torch.float32, device=logits.device)
+    for start in range(0, n_sup, chunk_size):
+        idx = sup_idx[start:start + chunk_size]
+        r = torch.softmax(shift_logits[idx].float(), dim=-1)
+        r[torch.arange(len(idx), device=logits.device), shift_labels[idx]] -= 1.0
+        r_bar += r.sum(0)
+        h_bar += shift_hidden[idx].float().sum(0)
+        del r
+    return r_bar / n_sup, h_bar / n_sup, n_sup
+
+
+def build_ablation_projectors(model, proj_dim, device):
+    """Rademacher projectors for the factor-mean ablations: res-only (V -> proj)
+    seed 11, h-only (d -> proj) seed 12. Pooled-factor reuses the seed-0 prod
+    projector on outer(r_bar, h_bar) so its rows share prod's basis."""
+    lm_head = model.get_output_embeddings()
+    V, d = lm_head.weight.shape
+    proj_r = projectorcls(proj_dim=int(proj_dim), grad_dim=int(V), seed=11,
+                          proj_type=ProjectionType.rademacher, device=device,
+                          dtype=torch.bfloat16, block_size=4, max_batch_size=8)
+    proj_h = projectorcls(proj_dim=int(proj_dim), grad_dim=int(d), seed=12,
+                          proj_type=ProjectionType.rademacher, device=device,
+                          dtype=torch.bfloat16, block_size=4, max_batch_size=8)
+    nf_r = torch.sqrt(torch.tensor(float(V), dtype=torch.float32, device=device))
+    nf_h = torch.sqrt(torch.tensor(float(d), dtype=torch.float32, device=device))
+    return proj_r, proj_h, nf_r, nf_h
+
+
+def run_ablation_pass(model, input_ids, labels, prod_projector,
+                      prod_normalize_factor, proj_r, proj_h, nf_r, nf_h):
+    """No-grad forward -> (honly_row, resonly_row, pooled_row).
+    pooled = prod projector applied to outer(r_bar, h_bar): same ingredients
+    as prod but binding destroyed (means before the outer product)."""
+    with torch.no_grad():
+        # No labels passed to the model: the CE loss is not needed and both
+        # wastes memory and trips OLMo's fused-loss path. Logits stay in
+        # model dtype here; compute_factor_means floats them per chunk
+        # (passing .float() upfront materialized a full fp32 [T,V] tensor
+        # and OOMed 7B teachers at 24GB).
+        outputs = model(input_ids=input_ids, output_hidden_states=True,
+                        use_cache=False)
+        r_bar, h_bar, n_sup = compute_factor_means(
+            outputs.logits, outputs.hidden_states[-1], labels)
+        res_row = (proj_r.project(r_bar.unsqueeze(0), model_id=0)
+                   / nf_r).squeeze(0).float().cpu().numpy()
+        h_row = (proj_h.project(h_bar.unsqueeze(0), model_id=0)
+                 / nf_h).squeeze(0).float().cpu().numpy()
+        pooled = torch.outer(r_bar, h_bar).reshape(1, -1)
+        pooled_row = (prod_projector.project(pooled, model_id=0)
+                      / prod_normalize_factor).squeeze(0).float().cpu().numpy()
+        del outputs, r_bar, h_bar, pooled
+        if input_ids.is_cuda:
+            torch.cuda.empty_cache()
+    return h_row, res_row, pooled_row
+
