+def run_prod_pass(
+    model,
+    input_ids,
+    labels,
+    prod_projector,
+    prod_normalize_factor,
+    s_r,
+    s_h,
+    row_scale_mode: str = ROW_SCALE_NONE,
+):
+    """Pass (a): torch.no_grad() forward + chunked prod features for ONE example.
+
+    Returns (prod_row, prod2s_row) as float32 numpy arrays. Aggressively frees
+    the logits / hidden-state / workspace tensors and empties the CUDA cache
+    before returning, so nothing from this pass coexists with the full-gradient
+    backward pass (otherwise both OOM together on 24GB cards). ``row_scale_mode`` is
+    applied after projection and therefore does not change feature direction.
+    """
+    with torch.no_grad():
+        outputs = model(input_ids=input_ids, output_hidden_states=True)
+        logits = outputs.logits
+        hidden = outputs.hidden_states[-1]
+        G, g2s, n_sup = compute_prod_features(logits, hidden, labels, s_r=s_r, s_h=s_h)
+        row_scale = row_scale_from_n_sup(n_sup, row_scale_mode)
+        del outputs, logits, hidden
+
+        # PRIMARY: exact output-readout gradient term, JL-projected like full grads.
+        # fast_jl only accepts fp16/fp32 input (the default full-grad path
+        # feeds fp32, since --dtype auto loads the model in fp32), so keep fp32.
+        g_flat = G.reshape(1, -1).contiguous()
+        projected_prod = prod_projector.project(g_flat, model_id=0) / prod_normalize_factor
+        if row_scale_mode != ROW_SCALE_NONE:
+            projected_prod.mul_(row_scale)
+        prod_row = projected_prod.squeeze(0).float().cpu().numpy()
+        del G, g_flat, projected_prod
+
+        # SECONDARY: two-sided sketch (accumulated tokenwise above, no (V, d) copy).
+        g2s_flat = g2s.reshape(-1) / prod_normalize_factor
+        if row_scale_mode != ROW_SCALE_NONE:
+            g2s_flat.mul_(row_scale)
+        prod2s_row = g2s_flat.float().cpu().numpy()
+        del g2s, g2s_flat
+
+    if input_ids.is_cuda:
+        torch.cuda.empty_cache()
+    return prod_row, prod2s_row
+
+
+def assert_zero_dropout(model: torch.nn.Module):
+    """The long-example ckpt path flips .train() temporarily; that is only a
+    numeric no-op if every dropout has p=0. Fail loudly otherwise."""
+    for name, module in model.named_modules():
+        if isinstance(module, torch.nn.Dropout) and module.p != 0.0:
+            raise RuntimeError(
+                f"Dropout module {name} has p={module.p} != 0; the checkpointed "
+                "full-grad pass would change numerics. Refusing to proceed."
+            )
+    attn_dropout = getattr(model.config, "attention_dropout", 0.0)
+    if attn_dropout != 0.0:
+        raise RuntimeError(
+            f"config.attention_dropout={attn_dropout} != 0; the checkpointed "
+            "full-grad pass would change numerics. Refusing to proceed."
+        )
+
+
+def run_full_grad_pass(model, input_ids, labels, use_lora, gradientproj, normalize_factor,
+                       ckpt_threshold: int = FULL_GRAD_CKPT_THRESHOLD_TOKENS,
+                       row_scale_mode: str = ROW_SCALE_NONE):
+    """Pass (b): the ORIGINAL forward + loss.backward() full-gradient path.
+
+    Returns the projected full-gradient row as a float32 numpy array. The
+    optional row scale is applied after projection.
+
+    For sequences longer than `ckpt_threshold` tokens, HF gradient checkpointing
+    (use_reentrant=False) is enabled for THIS example only; the plain fp32 path
+    OOMs on 24GB cards above T~42xx (see file header). Checkpointing replays the
+    same fp32 ops, so the gradient is fp32-machine-precision equivalent
+    (measured rel L2 ~5e-6 on the projected row, see file header).
+    """
+    # Keep the default path behavior unchanged: avoid a new device sync and
+    # batch-shape restriction unless the paper-length adapter was requested.
+    if row_scale_mode == ROW_SCALE_NONE:
+        row_scale = 1.0
+    else:
+        row_scale = row_scale_from_n_sup(
+            supervised_token_count(labels), row_scale_mode
+        )
+    use_ckpt = input_ids.shape[1] > ckpt_threshold
+    was_training = model.training
+    if use_ckpt:
+        assert_zero_dropout(model)
+        model.gradient_checkpointing_enable(
+            gradient_checkpointing_kwargs={"use_reentrant": False}
+        )
+        # HF only routes through the checkpointing func in training mode; with
+        # all dropout asserted zero this is a numeric no-op.
+        model.train(True)
+    try:
+        if use_ckpt:
+            outputs = model(input_ids=input_ids, labels=labels, use_cache=False)
+        else:
+            outputs = model(input_ids=input_ids, labels=labels)
+        loss = outputs.loss
+        loss.backward()
+
+        grads = extract_gradients(model, use_lora)
+        collected_grads = grads.unsqueeze(0)
+        projected_grad = gradientproj.project(collected_grads, model_id=0) / normalize_factor
+        if row_scale_mode != ROW_SCALE_NONE:
+            projected_grad.mul_(row_scale)
+        row = projected_grad.squeeze(0).detach().cpu().numpy()
+
+        del outputs, loss, grads, collected_grads, projected_grad
+        model.zero_grad(set_to_none=True)
+    finally:
+        if use_ckpt:
+            model.gradient_checkpointing_disable()
+            model.train(was_training)
+            if input_ids.is_cuda:
+                torch.cuda.empty_cache()
+    return row
+
+
+def derive_ablation_paths(base_path: str):
+    root, ext = os.path.splitext(base_path)
+    ext = ext or ".pkl"
+    return (f"{root}_honly{ext}", f"{root}_resonly{ext}", f"{root}_pooled{ext}")
+
+
+def derive_prod2s_path(prod_output_path: str) -> str:
+    root, ext = os.path.splitext(prod_output_path)
+    if ext == "":
+        return prod_output_path + "_prod2s"
+    return f"{root}_prod2s{ext}"
+
+
+def sanity_check_features(rows, name: str, expected_n: int, expected_dim: int):
+    """NO-SILENT-FALLBACKS policy: fail loudly before writing wrong-but-plausible data."""
+    arr = np.asarray(rows, dtype=np.float64)
+    if arr.ndim != 2:
+        raise RuntimeError(f"[{name}] expected 2D feature array, got shape {arr.shape}")
+    if arr.shape != (expected_n, expected_dim):
+        raise RuntimeError(
+            f"[{name}] expected shape {(expected_n, expected_dim)}, got {arr.shape}"
+        )
+    if not np.isfinite(arr).all():
+        raise RuntimeError(f"[{name}] non-finite values in features")
+    if float(arr.std()) <= 0.0:
+        raise RuntimeError(f"[{name}] zero variance across all features")
+    n_unique = len({row.tobytes() for row in arr})
+    if n_unique <= expected_n // 2:
+        raise RuntimeError(
+            f"[{name}] only {n_unique}/{expected_n} unique rows — looks like the "
+            "empty-prompt/duplicate-feature bug class; refusing to write."
+        )
+    print(f"[{name}] sanity OK: shape={arr.shape}, std={arr.std():.3e}, unique_rows={n_unique}/{expected_n}")
+
+
+def save_pickle(rows, path: str, name: str, expected_n: int, expected_dim: int):
+    sanity_check_features(rows, name, expected_n, expected_dim)
+    out_dir = os.path.dirname(path)
+    if out_dir:
+        os.makedirs(out_dir, exist_ok=True)
+    print(f"Saving {name} to: {path}")
+    with open(path, "wb") as f:
+        pickle.dump(rows, f)
+
 
