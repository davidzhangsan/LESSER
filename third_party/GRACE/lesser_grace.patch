@@ -0,0 +1,36 @@
+#!/bin/bash
+# MATH-setting teacher generation.
+# data/math_512.jsonl (repo seed-42 subset convention) x 4 responses, T=0.6,
+# top_p 1.0, max_tokens 4096. vLLM caps for 24GB GPUs, as for the larger GSM8K
+# teachers: --max_model_len 4096 --max_num_seqs 64
+# --gpu_memory_utilization 0.85 (Gemma-9B / OLMo-2 need them; harmless elsewhere).
+# One sequential queue per GPU: bash scripts/math_gen_queue.sh <gpu> <hf>=<short> ...
+# Produces the MATH teacher responses behind LESSER paper Table 12, row 3.
+# GEN_PY: python with vLLM (default: python; the paper runs used vllm 0.11.0).
+set -u
+cd "$(dirname "${BASH_SOURCE[0]}")/.."
+PY="${GEN_PY:-python}"  # generation env (vllm)
+GPU=${1:?gpu id}; shift
+mkdir -p data/math_synthetic logs_gen
+for SPEC in "$@"; do
+  HF="${SPEC%%=*}"; T="${SPEC##*=}"
+  OUT="data/math_synthetic/${T}.jsonl"
+  if [ -s "$OUT" ]; then echo "[mq$GPU] skip $T (exists)"; continue; fi
+  echo "[mq$GPU] generating $T ..."
+  CUDA_VISIBLE_DEVICES=$GPU NCCL_P2P_DISABLE=1 NCCL_IB_DISABLE=1 \
+  $PY data_generation/generate_responses.py \
+    --model_path "$HF" \
+    --input_file data/math_512.jsonl \
+    --output_file "$OUT" \
+    --temperature 0.6 \
+    --top_p 1.0 \
+    --max_tokens 4096 \
+    --responses_per_question 4 \
+    --tensor_parallel_size 1 \
+    --gpu_memory_utilization 0.85 \
+    --max_model_len 4096 --max_num_seqs 64 \
+    > "logs_gen/math_${T}.log" 2>&1
+  rc=$?
+  echo "[mq$GPU] $T rc=$rc"
+done
+echo "[mq$GPU] QUEUE_DONE"
diff --git a/scripts/math_subset_512.py b/scripts/math_subset_512.py
new file mode 100644
index 0000000000000000000000000000000000000000..2ddfd570c2e426e427a56622abb9cb413d8c7617
--- /dev/null
+++ b/scripts/math_subset_512.py
@@ -0,0 +1,85 @@
+"""Deterministic 512-problem MATH subsample for the MATH setting
+(task=MATH, student=meta-llama/Llama-3.2-3B base).
+
+Source: data/math/train.jsonl (7500 rows, GRACE authors' initial commit; level
+distribution matches Hendrycks MATH train; disjoint from data/math/test.jsonl).
+NOTE: the authors' unique_id fields all carry a "test/..." path prefix in BOTH
+splits; we treat the repo files as ground truth and record unique_id verbatim.
+
+Convention: EXACTLY the repo's own subset convention (scripts/generate_subset.py
+== tokenize_data.py lines 172-176): rng = random.Random(42); shuffle the jsonl-
+order list; take the first 512; write IN SHUFFLED ORDER so that downstream
+tokenize_data.py WITHOUT --subsample-questions reproduces the per-question
+response-subsample seeds 13*example_idx + 13.
+
+generate_subset.py itself is not reused because it asserts a "question" key,
+while data/math uses "problem". This script replicates its logic and normalizes
+the schema to the gsm8k_synthetic convention:
+  question <- problem      (prompt text; generate_responses.py finds "question")
+  answer   <- solution     (full gold CoT with \\boxed{}, role-matching gsm8k's
+                            full solution; the short final answer is kept as
+                            answer_short)
+  idx      <- 0-based line index in data/math/train.jsonl
+Extra provenance fields kept: level, subject, unique_id, answer_short.
+NO SILENT FALLBACKS: every required key is asserted per item.
+"""
+
+import json
+import os
+import random
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+IN_PATH = os.path.join(REPO_ROOT, "data", "math", "train.jsonl")
+OUT_PATH = os.path.join(REPO_ROOT, "data", "math_512.jsonl")
+N_QUESTIONS = 512
+SEED = 42
+
+REQUIRED = ("problem", "solution", "answer", "level", "subject", "unique_id")
+
+
+def main():
+    data = []
+    with open(IN_PATH, "r", encoding="utf-8") as f:
+        for line_idx, line in enumerate(f):
+            line = line.strip()
+            if not line:
+                continue
+            item = json.loads(line)
+            for k in REQUIRED:
+                if k not in item:
+                    raise RuntimeError(f"line {line_idx}: missing key {k!r}; keys={sorted(item)}")
+            data.append({
+                "question": str(item["problem"]),
+                "answer": str(item["solution"]),
+                "answer_short": str(item["answer"]),
+                "level": item["level"],
+                "subject": item["subject"],
+                "unique_id": item["unique_id"],
+                "idx": line_idx,
+            })
+    print(f"Loaded {len(data)} items from {IN_PATH}")
+    if len(data) != 7500:
+        raise RuntimeError(f"expected 7500 MATH train items, got {len(data)}")
+
+    # Exact replication of tokenize_data.py lines 172-176 / generate_subset.py.
+    rng = random.Random(SEED)
+    data = data[:]
+    rng.shuffle(data)
+    subset = data[:N_QUESTIONS]
+    if len(subset) != N_QUESTIONS:
+        raise RuntimeError("subset size mismatch")
+    if len({it["idx"] for it in subset}) != N_QUESTIONS:
+        raise RuntimeError("duplicate idx in subset")
+
+    with open(OUT_PATH, "w", encoding="utf-8") as f:
+        for item in subset:
+            f.write(json.dumps(item, ensure_ascii=False) + "\n")
+
+    print(f"Wrote {len(subset)} items (shuffled order) to {OUT_PATH}")
+    print(f"Provenance: seed={SEED}, first 10 original line idx: {[it['idx'] for it in subset[:10]]}")
+    import collections
+    print("levels:", dict(collections.Counter(it["level"] for it in subset)))
+
+
+if __name__ == "__main__":
+    main()
