+#!/usr/bin/env python
+"""MATH / Llama-3.2-3B full-gradient features for LESSER paper Table 12, row 3 (scores via
+grace/score.py of the LESSER code release). --code-dir defaults to this checkout's GRACE/,
+and --num-sms defaults to 128. The paper run peaked at 49.4 GiB of allocated GPU memory
+(fp32 3B student: parameters, gradients, concatenated gradient).
+
+Student: meta-llama/Llama-3.2-3B (BASE), fp32. The paper run used an RTX PRO 6000
+Blackwell 96GB GPU: the fp32 3B params+grads+concat (~38.6GB) do not fit a 24GB
+RTX 4090, on which the other banks were computed.
+
+Data: <data-dir>/<short>.hf (2048 rows = 512 problems x 4 gens, tokenized with
+the student tokenizer by scripts/math_tokenize_all.sh).
+
+Per row, using the UNMODIFIED pipeline function run_full_grad_pass from
+GRACE/gradient_computation.py: forward + loss.backward(), ALL trainable parameter gradients
+concatenated in named_parameters order (grad_dim=3,212,749,824), projected with
+the pipeline's CudaProjector(seed=0, rademacher, proj_dim=512) / sqrt(grad_dim).
+Sequences > 2560 tokens use the pipeline's own gradient-checkpointing path
+(fp32-machine-precision equivalent, measured at rel ~5e-6 by scripts/memory_probe_both.py).
+
+Checks run before the paper run (separate one-time scripts, not included): fast_jl
+validity above 2^31 dims, cross-GPU projector identity with num_sms pinned to 128, PROD
+2-row equivalence against rows computed on the RTX 4090, fp32 load under transformers 5.3.
+
+INTENTIONAL DIVERGENCE from the upstream default: dtype requested as
+"float32" explicitly instead of "auto" (float32 under the transformers 4.51.1 of
+the other runs) — transformers 5.3 may resolve auto to the bf16 checkpoint dtype;
+fp32 is asserted after load.
+
+NO-SILENT-FALLBACK gates per teacher (all raise):
+  - dataset has exactly 2048 rows with input_ids/labels columns;
+  - save_pickle's built-in checks: shape (2048,512), finite, std>0,
+    unique rows > 50%;
+  - 2-row recompute determinism (deterministic random.Random(short) rows),
+    cos > 0.999999 and max rel diff < 1e-4 (same convention as
+    scripts/featurize_math_prod.py);
+  - grad_dim == 3,212,749,824 and fp32 params asserted at startup.
+
+Output: <out-dir>/Gradients_<short>.pkl (list of 2048 float32 arrays, d=512,
+same pickle format as the gsm8k Gradients caches) + mathfg_meta_<short>.json
+(gates + stats + timing; written last = completion marker, so the run is
+resumable per teacher).
+"""
+import argparse
+import json
+import os
+import pickle
+import random
+import sys
+import time
+
+import numpy as np
+import torch
+from datasets import load_from_disk
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+ap = argparse.ArgumentParser()
+ap.add_argument("--code-dir", default=os.path.join(REPO, "GRACE"),
+                help="directory holding gradient_computation.py (default: this checkout)")
+ap.add_argument("--data-dir", required=True)
+ap.add_argument("--out-dir", required=True)
+ap.add_argument("--device", default="cuda:0")
+ap.add_argument("--teachers", nargs="+", required=True)
+ap.add_argument("--num-sms", type=int, default=128,
+                help="SM count pinned for fast_jl (128 = the stored paper features)")
+args = ap.parse_args()
+
+sys.path.insert(0, args.code_dir)
+from gradient_computation import (  # noqa: E402  (unmodified pipeline module)
+    IGNORE_INDEX,
+    build_model,
+    run_full_grad_pass,
+    save_pickle,
+    set_projector_num_sms,
+)
+import transformers  # noqa: E402
+
+STUDENT = "meta-llama/Llama-3.2-3B"
+EXPECTED_GRAD_DIM = 3_212_749_824
+PROJ_DIM = 512
+N_ROWS = 2048
+
+ALL_TEACHERS = [
+    "Qwen2.5-Math-1.5B-Instruct", "Qwen2.5-1.5B-Instruct", "Qwen2.5-Math-7B-Instruct",
+    "Qwen2.5-3B-Instruct", "Llama-3.2-3B-Instruct", "Qwen2.5-7B-Instruct",
+    "Gemma-2-2b-it", "Llama-3.1-8B-Instruct", "OLMo-2-7B-Instruct", "Gemma-2-9b-it",
+    # Four larger teachers of the 14-teacher GSM8K roster:
+    "Qwen2.5-14B-Instruct", "Phi-4", "OLMo-2-13B-Instruct", "Gemma-2-27b-it",
+]
+for t in args.teachers:
+    if t not in ALL_TEACHERS:
+        raise ValueError(f"unknown teacher {t}")
+
+os.makedirs(args.out_dir, exist_ok=True)
+device = args.device
+torch.manual_seed(0)
+print(f"[load] student {STUDENT} fp32 (transformers {transformers.__version__})", flush=True)
+model, gradientproj, normalize_factor, grad_dim = build_model(
+    student_pth=STUDENT, device=device, use_lora=False, proj_dim=PROJ_DIM, dtype="float32",
+)
+model.eval()
+# fast_jl's sign stream depends on the num_sms launch argument; forcing the
+# RTX 4090 value (128) reproduces the RTX 4090 projection on other GPUs
+# (measured cross-GPU cos 0.9999916 at the full-grad dim).
+set_projector_num_sms(gradientproj, args.num_sms)
+if next(model.parameters()).dtype != torch.float32:
+    raise RuntimeError("student not fp32")
+if grad_dim != EXPECTED_GRAD_DIM:
+    raise RuntimeError(f"grad_dim {grad_dim} != {EXPECTED_GRAD_DIM}")
+print(f"[load] grad_dim={grad_dim} ok", flush=True)
+
+for short in args.teachers:
+    meta_path = os.path.join(args.out_dir, f"mathfg_meta_{short}.json")
+    if os.path.exists(meta_path):
+        print(f"[skip] {short} complete ({meta_path})", flush=True)
+        continue
+    t0 = time.time()
+    data = load_from_disk(os.path.join(args.data_dir, f"{short}.hf"))
+    if len(data) != N_ROWS:
+        raise RuntimeError(f"{short}: {len(data)} rows != {N_ROWS}")
+    for col in ("input_ids", "labels"):
+        if col not in data.column_names:
+            raise RuntimeError(f"{short}: missing column {col}; have {data.column_names}")
+
+    grad_rows = []
+    seq_len = np.zeros(N_ROWS, dtype=np.int64)
+    n_ckpt = 0
+    for row in range(N_ROWS):
+        d = data[row]
+        ii = torch.tensor([d["input_ids"]], device=device)
+        ll = torch.tensor([d["labels"]], device=device)
+        seq_len[row] = ii.shape[1]
+        if int((np.asarray(d["labels"])[1:] != IGNORE_INDEX).sum()) < 1:
+            raise RuntimeError(f"{short} row {row}: zero supervised positions")
+        if ii.shape[1] > 2560:
+            n_ckpt += 1
+        grad_rows.append(
+            run_full_grad_pass(model, ii, ll, False, gradientproj, normalize_factor)
+        )
+        del ii, ll
+        if (row + 1) % 128 == 0:
+            el = time.time() - t0
+            print(f"[{short}] {row+1}/{N_ROWS} rows, {el:.0f}s ({el/(row+1):.2f} s/row, "
+                  f"peak {torch.cuda.max_memory_allocated()/2**30:.1f} GiB)", flush=True)
+
+    # ---- 2-row recompute determinism gate (same convention as featurize_math_prod.py) ----
+    chk = random.Random(short).sample(range(N_ROWS), 2)
+    det = {}
+    for row in chk:
+        d = data[row]
+        ii = torch.tensor([d["input_ids"]], device=device)
+        ll = torch.tensor([d["labels"]], device=device)
+        g = run_full_grad_pass(model, ii, ll, False, gradientproj, normalize_factor)
+        ref = grad_rows[row]
+        cos = float(np.dot(g, ref) / (np.linalg.norm(g) * np.linalg.norm(ref)))
+        rel = float(np.abs(g - ref).max() / (np.abs(ref).max() + 1e-30))
+        det[row] = {"cos": cos, "max_rel_diff": rel, "seq_len": int(ii.shape[1])}
+        if cos < 0.999999 or rel > 1e-4:
+            raise RuntimeError(f"{short} row {row}: recompute mismatch cos={cos} rel={rel}")
+        del ii, ll
+    print(f"[{short}] determinism gate passed on rows {chk}: {det}", flush=True)
+
+    # ---- save (save_pickle = pipeline sanity: shape/finite/std/unique) ----
+    save_pickle(grad_rows, os.path.join(args.out_dir, f"Gradients_{short}.pkl"),
+                f"full_grad[{short}]", N_ROWS, PROJ_DIM)
+
+    arr = np.asarray(grad_rows, dtype=np.float32)
+    uniq = len({r.tobytes() for r in arr})
+    meta = {
+        "student": STUDENT, "proj_dim": PROJ_DIM, "grad_dim": int(grad_dim),
+        "projector": "CudaProjector rademacher seed=0 / sqrt(grad_dim), pipeline convention",
+        "dtype": "float32 (explicit; auto==fp32 under transformers 4.51.1)",
+        "transformers": transformers.__version__, "torch": torch.__version__,
+        "gpu": torch.cuda.get_device_properties(0).name,
+        "num_sms_forced": args.num_sms,
+        "n_rows": N_ROWS, "seconds": time.time() - t0,
+        "s_per_row": (time.time() - t0) / N_ROWS,
+        "n_ckpt_rows_gt2560": n_ckpt,
+        "grad_std": float(arr.std()), "grad_unique_rows": uniq,
+        "grad_row_norm_mean": float(np.linalg.norm(arr, axis=1).mean()),
+        "seq_len": {"mean": float(seq_len.mean()), "max": int(seq_len.max())},
+        "peak_mem_gib": round(torch.cuda.max_memory_allocated() / 2**30, 2),
+        "determinism_rows": det,
+    }
+    with open(meta_path, "w") as f:
+        json.dump(meta, f, indent=2)
+    print(f"[{short}] saved ({time.time()-t0:.0f}s): {meta_path}", flush=True)
+
+print("[done]", flush=True)
