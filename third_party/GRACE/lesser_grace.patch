index 0000000000000000000000000000000000000000..23838c5db50a77c409072539876fad0ba5b9c690
--- /dev/null
+++ b/scripts/featurize_math_prod.py
@@ -0,0 +1,202 @@
+#!/usr/bin/env python
+"""MATH / Llama-3.2-3B LESSER features for LESSER paper Table 12, row 3 (the full-gradient
+features come from scripts/featurize_math_full.py; scores via grace/score.py of the
+LESSER code release). The fast_jl SM count is pinned (--num-sms, default 128), and the
+student is loaded in float32 explicitly (transformers 4.51.1 loads float32 by default;
+newer releases may load the bf16 checkpoint dtype).
+
+Student: meta-llama/Llama-3.2-3B (BASE, per the paper's MATH setting), fp32.
+Data: grace_data/math_synthetic/<short>.hf (2048 rows = 512 problems x 4 gens,
+tokenized with the STUDENT tokenizer by data_generation/tokenize_data.py).
+
+Per row, using the UNMODIFIED pipeline functions from GRACE/gradient_computation.py:
+  - prod    : run_prod_pass -> exact output-readout contribution
+              G = (1/n_sup) R^T H (the student has tied embeddings),
+              flattened (V*d) through CudaProjector(seed=0, rademacher,
+              proj_dim=512) / sqrt(V*d). Saved as Prod_<short>.pkl
+              (list of 2048 float32 arrays, same format as the gsm8k caches).
+  - prod2s  : two-sided sketch from the same pass -> Prod_<short>_prod2s.pkl.
+  - nll     : mean per-token NLL = HF model(input_ids, labels).loss (no_grad),
+              i.e. exactly the mean-CE the gradients differentiate.
+  - tok     : n_sup = number of supervised shifted positions (labels != -100).
+              nll+tok saved as nll_tok_<short>.npz (nll f64, tok_count i64).
+
+NO-SILENT-FALLBACK gates, all raise on failure:
+  - dataset must have exactly 2048 rows with input_ids/labels columns;
+  - save_pickle's built-in checks: shape (2048,512), finite, std>0,
+    unique rows > 50%;
+  - 2-row recompute determinism: after the full pass, 2 deterministic random
+    rows are recomputed with run_prod_pass and must match the stored row
+    (cos > 0.999999 and max|diff| relative < 1e-4);
+  - tok_count >= 1 everywhere (compute_prod_features itself raises at 0),
+    nll finite with std > 0.
+
+Output dir: --out-dir (+ per-teacher meta json math_prod_meta_<short>.json,
+written last = completion marker). The nll_tok_<short>.npz files and the prod2s
+pickles are by-products that no LESSER paper result uses.
+
+Run (one queue per GPU):
+  CUDA_VISIBLE_DEVICES=<g> .venv/bin/python scripts/featurize_math_prod.py \
+    --out-dir <features>/math_llama3b --teachers <short> [<short> ...]
+"""
+import argparse
+import json
+import os
+import pickle
+import random
+import sys
+import time
+
+import numpy as np
+import torch
+from datasets import load_from_disk
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.join(REPO, "GRACE"))
+from gradient_computation import (  # noqa: E402  (unmodified pipeline module)
+    IGNORE_INDEX,
+    PROD2S_R_DIM,
+    PROD2S_H_DIM,
+    build_prod_projector,
+    run_prod_pass,
+    save_pickle,
+    set_projector_num_sms,
+)
+from transformers import AutoModelForCausalLM  # noqa: E402
+
+STUDENT = "meta-llama/Llama-3.2-3B"
+PROJ_DIM = 512
+N_ROWS = 2048
+
+ALL_TEACHERS = [
+    "Qwen2.5-Math-1.5B-Instruct", "Qwen2.5-1.5B-Instruct", "Qwen2.5-Math-7B-Instruct",
+    "Qwen2.5-3B-Instruct", "Llama-3.2-3B-Instruct", "Qwen2.5-7B-Instruct",
+    "Gemma-2-2b-it", "Llama-3.1-8B-Instruct", "OLMo-2-7B-Instruct", "Gemma-2-9b-it",
+    # Four larger teachers of the 14-teacher GSM8K roster:
+    "Qwen2.5-14B-Instruct", "Phi-4", "OLMo-2-13B-Instruct", "Gemma-2-27b-it",
+]
+
+
+def n_supervised(labels_row):
+    lab = np.asarray(labels_row)
+    n_sup = int((lab[1:] != IGNORE_INDEX).sum())  # HF causal shift
+    if n_sup < 1:
+        raise RuntimeError("row with zero supervised shifted positions")
+    return n_sup
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--teachers", nargs="+", required=True, choices=ALL_TEACHERS)
+    ap.add_argument("--out-dir", required=True, help="where the feature pickles are written")
+    ap.add_argument("--data-dir", default=os.path.join(REPO, "grace_data", "math_synthetic"),
+                    help="tokenized MATH sets <short>.hf from scripts/math_tokenize_all.sh")
+    ap.add_argument("--num-sms", type=int, default=128,
+                    help="SM count pinned for fast_jl (128 = the stored paper features)")
+    args = ap.parse_args()
+    OUT = args.out_dir
+
+    os.makedirs(OUT, exist_ok=True)
+    device = "cuda"
+    torch.manual_seed(0)
+    print(f"[load] student {STUDENT} fp32", flush=True)
+    model = AutoModelForCausalLM.from_pretrained(STUDENT, torch_dtype=torch.float32).to(device)
+    model.eval()
+    if next(model.parameters()).dtype != torch.float32:
+        raise RuntimeError("student not fp32")
+    lm_head = model.get_output_embeddings()
+    vocab_size, hidden_dim = lm_head.weight.shape
+    print(f"vocab={vocab_size} hidden={hidden_dim} tied={model.config.tie_word_embeddings}", flush=True)
+
+    prod_projector, prod_norm, s_r, s_h = build_prod_projector(model, PROJ_DIM, device)
+    set_projector_num_sms(prod_projector, args.num_sms)
+
+    for short in args.teachers:
+        meta_path = os.path.join(OUT, f"math_prod_meta_{short}.json")
+        if os.path.exists(meta_path):
+            print(f"[skip] {short} complete ({meta_path})", flush=True)
+            continue
+        t0 = time.time()
+        data = load_from_disk(os.path.join(args.data_dir, f"{short}.hf"))
+        if len(data) != N_ROWS:
+            raise RuntimeError(f"{short}: {len(data)} rows != {N_ROWS}")
+        for col in ("input_ids", "labels"):
+            if col not in data.column_names:
+                raise RuntimeError(f"{short}: missing column {col}; have {data.column_names}")
+
+        prod_rows, prod2s_rows = [], []
+        tok = np.zeros(N_ROWS, dtype=np.int64)
+        nll = np.zeros(N_ROWS, dtype=np.float64)
+        seq_len = np.zeros(N_ROWS, dtype=np.int64)
+        for row in range(N_ROWS):
+            d = data[row]
+            ii = torch.tensor([d["input_ids"]], device=device)
+            ll = torch.tensor([d["labels"]], device=device)
+            seq_len[row] = ii.shape[1]
+            tok[row] = n_supervised(d["labels"])
+            p_row, p2_row = run_prod_pass(model, ii, ll, prod_projector, prod_norm, s_r, s_h)
+            prod_rows.append(p_row)
+            prod2s_rows.append(p2_row)
+            with torch.no_grad():
+                nll[row] = float(model(input_ids=ii, labels=ll).loss)
+            del ii, ll
+            if (row + 1) % 256 == 0:
+                el = time.time() - t0
+                print(f"[{short}] {row+1}/{N_ROWS} rows, {el:.0f}s ({el/(row+1):.2f} s/row)", flush=True)
+
+        # ---- 2-row recompute determinism gate ----
+        chk = random.Random(short).sample(range(N_ROWS), 2)
+        det = {}
+        for row in chk:
+            d = data[row]
+            ii = torch.tensor([d["input_ids"]], device=device)
+            ll = torch.tensor([d["labels"]], device=device)
+            p_row, _ = run_prod_pass(model, ii, ll, prod_projector, prod_norm, s_r, s_h)
+            ref = prod_rows[row]
+            cos = float(np.dot(p_row, ref) / (np.linalg.norm(p_row) * np.linalg.norm(ref)))
+            rel = float(np.abs(p_row - ref).max() / (np.abs(ref).max() + 1e-30))
+            det[row] = {"cos": cos, "max_rel_diff": rel}
+            if cos < 0.999999 or rel > 1e-4:
+                raise RuntimeError(f"{short} row {row}: recompute mismatch cos={cos} rel={rel}")
+            del ii, ll
+        print(f"[{short}] determinism gate passed on rows {chk}: {det}", flush=True)
+
+        # ---- scalar sanity ----
+        if not np.isfinite(nll).all() or float(nll.std()) <= 0.0:
+            raise RuntimeError(f"{short}: bad nll vector")
+        if tok.min() < 1:
+            raise RuntimeError(f"{short}: min tok_count {tok.min()} < 1")
+
+        # ---- save (save_pickle = pipeline sanity: shape/finite/std/unique) ----
+        save_pickle(prod_rows, os.path.join(OUT, f"Prod_{short}.pkl"),
+                    f"prod[{short}]", N_ROWS, PROJ_DIM)
+        save_pickle(prod2s_rows, os.path.join(OUT, f"Prod_{short}_prod2s.pkl"),
+                    f"prod2s[{short}]", N_ROWS, PROD2S_R_DIM * PROD2S_H_DIM)
+        np.savez(os.path.join(OUT, f"nll_tok_{short}.npz"), nll=nll, tok_count=tok,
+                 seq_len=seq_len)
+
+        arr = np.asarray(prod_rows, dtype=np.float32)
+        uniq = len({r.tobytes() for r in arr})
+        meta = {
+            "student": STUDENT, "proj_dim": PROJ_DIM, "vocab": int(vocab_size),
+            "hidden": int(hidden_dim), "grad_dim": int(vocab_size) * int(hidden_dim),
+            "projector": "CudaProjector rademacher seed=0 / sqrt(V*d), pipeline convention",
+            "n_rows": N_ROWS, "seconds": time.time() - t0,
+            "prod_std": float(arr.std()), "prod_unique_rows": uniq,
+            "prod_row_norm_mean": float(np.linalg.norm(arr, axis=1).mean()),
+            "tok_count": {"mean": float(tok.mean()), "median": float(np.median(tok)),
+                          "min": int(tok.min()), "max": int(tok.max())},
+            "seq_len": {"mean": float(seq_len.mean()), "max": int(seq_len.max())},
+            "nll": {"mean": float(nll.mean()), "std": float(nll.std()),
+                    "min": float(nll.min()), "max": float(nll.max())},
+            "determinism_rows": det,
+        }
+        with open(meta_path, "w") as f:
+            json.dump(meta, f, indent=2)
+        print(f"[{short}] saved ({time.time()-t0:.0f}s): {meta_path}", flush=True)
+
+    print("[done]", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/featurize_olmo_student.py b/scripts/featurize_olmo_student.py
new file mode 100644
index 0000000000000000000000000000000000000000..0223a6a7e3591d6fa16537470560c7b225c2c309
--- /dev/null
+++ b/scripts/featurize_olmo_student.py
@@ -0,0 +1,279 @@
+#!/usr/bin/env python
+"""GSM8K / OLMo-2-1B features for LESSER paper Table 12, row 2 (full-gradient and LESSER
+features of the ten original teachers; scores via grace/score.py of the LESSER code
+release). The fast_jl SM count is pinned (--num-sms, default 128).
+
+SECOND-STUDENT setting: rescore the SAME 10 teachers' GSM8K generations with
+student allenai/OLMo-2-0425-1B (BASE, UNTIED embeddings: tie_word_embeddings=False,
+verified from config; breaks the tied-embedding confound of Llama-3.2-1B).
+
+Reuses UNMODIFIED pipeline functions from GRACE/gradient_computation.py
+(build_model / build_prod_projector / run_prod_pass / run_full_grad_pass) and
+UNMODIFIED data_generation/tokenize_data.build_example. Rebuilds the exact
+512x4 scoring subsets from the raw generation JSONLs with the same 4-of-16
+subsample rule (random.Random(13*idx+13), shuffle, first 4) used to build the
+stored .hf subsets; a pre-run scan verified problem/solution text of ALL 2048
+rebuilt rows equals the stored .hf rows for every teacher (0 mismatches).
+
+INTENTIONAL DIVERGENCES from the Llama-student pipeline:
+  - max_length=4096 truncation in build_example: OLMo-2 max_position_embeddings
+    is 4096; 13/20480 rows across all teachers exceed it (8 Qwen-Math-7B,
+    3 Llama-3.2-3B, 2 Llama-3.1-8B). Truncated row indices are recorded in meta.
+  - full-grad gradient-checkpoint threshold lowered 2560 -> 2048 tokens: OLMo-2
+    1B has ~1.48B params (untied head) vs Llama-3.2-1B's 1.24B, so params+grads
+    +concat cost ~2GB more; rows >2048 tokens are <=8 per teacher.
+
+Sanity gates per teacher (fail loudly, no silent fallback):
+  - determinism: rows {0, 1017} recomputed twice back-to-back, prod+full rows
+    must agree to cos > 1-1e-9 and rel L2 < 1e-6;
+  - lm_head-grad exactness (first teacher): unprojected G from
+    compute_prod_features must match autograd lm_head.weight.grad (untied =>
+    exactly the head block) with cos > 0.9999;
+  - save_pickle's built-in checks: finite, nonzero variance, unique rows.
+
+Partial progress: per-teacher .partial.npz checkpoints every 256 rows; resume.
+Outputs: <out-dir>/{Gradients,Prod,Prod_*_prod2s}_<short>.pkl (+ featurize_meta.json)
+
+Run: CUDA_VISIBLE_DEVICES=0 .venv/bin/python scripts/featurize_olmo_student.py \
+         --out-dir <features>/gsm8k_olmo1b [--data-dir data/gsm8k_synthetic]
+"""
+import argparse
+import json
+import os
+import pickle
+import random
+import sys
+import time
+
+import numpy as np
+import torch
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.join(REPO, "GRACE"))
+sys.path.insert(0, os.path.join(REPO, "data_generation"))
+from gradient_computation import (  # noqa: E402  (unmodified pipeline module)
+    IGNORE_INDEX,
+    build_model,
+    build_prod_projector,
+    compute_prod_features,
+    run_full_grad_pass,
+    run_prod_pass,
+    save_pickle,
+    set_projector_num_sms,
+)
+from tokenize_data import build_example  # noqa: E402  (unmodified)
+from transformers import AutoTokenizer  # noqa: E402
+
+STUDENT = "allenai/OLMo-2-0425-1B"
+PROJ_DIM = 512
+NQ, NRESP, NGEN = 512, 16, 4
+MAX_LEN = 4096          # OLMo-2 max_position_embeddings
+CKPT_THRESHOLD = 2048   # lowered vs pipeline default 2560 (see header)
+DET_ROWS = (0, 1017)
+
+# Priority order (score-spread first).
+TEACHERS = [
+    "Gemma-2-2b-it", "Gemma-2-9b-it",
+    "Qwen2.5-1.5B-Instruct", "Qwen2.5-3B-Instruct",
+    "Llama-3.2-3B-Instruct", "OLMo-2-7B-Instruct",
+    "Qwen2.5-Math-1.5B-Instruct", "Qwen2.5-Math-7B-Instruct",
+    "Qwen2.5-7B-Instruct", "Llama-3.1-8B-Instruct",
+]
+
+
+def load_jsonl(path):
+    return [json.loads(l) for l in open(path) if l.strip()]
+
+
+def build_subset(short, tokenizer, data_dir):
+    """Rebuild the 512x4 scoring subset with OLMo tokenization. Returns
+    (list of dicts with input_ids/labels, truncated_row_indices)."""
+    syn = load_jsonl(os.path.join(data_dir, f"{short}.jsonl"))
+    if len(syn) != NQ:
+        raise RuntimeError(f"{short}: expected {NQ} questions, got {len(syn)}")
+    rows, truncated = [], []
+    for idx in range(NQ):
+        problem = syn[idx].get("question", syn[idx].get("problem"))
+        if problem is None:
+            raise RuntimeError(f"{short} q{idx}: no question/problem key")
+        responses = syn[idx]["responses"]
+        if len(responses) != NRESP:
+            raise RuntimeError(f"{short} q{idx}: {len(responses)} responses != {NRESP}")
+        rng = random.Random(idx * 13 + 13)
+        resp = responses[:]
+        rng.shuffle(resp)
+        for j in range(NGEN):
+            item = build_example(problem, str(resp[j]), tokenizer, IGNORE_INDEX,
+                                 max_length=MAX_LEN)
+            item_nt = build_example(problem, str(resp[j]), tokenizer, IGNORE_INDEX)
+            if len(item_nt["input_ids"]) > MAX_LEN:
+                truncated.append(idx * NGEN + j)
+            if sum(x != IGNORE_INDEX for x in item["labels"]) == 0:
+                raise RuntimeError(f"{short} row {idx*NGEN+j}: zero supervised tokens")
+            rows.append(item)
+    return rows, truncated
+
+
+def compute_row(model, item, device, prod_projector, prod_norm, s_r, s_h,
+                gradientproj, normalize_factor):
+    input_ids = torch.tensor(item["input_ids"], device=device).unsqueeze(0)
+    labels = torch.tensor(item["labels"], device=device).unsqueeze(0)
+    prod_row, prod2s_row = run_prod_pass(
+        model, input_ids, labels, prod_projector, prod_norm, s_r, s_h)
+    full_row = run_full_grad_pass(
+        model, input_ids, labels, False, gradientproj, normalize_factor,
+        ckpt_threshold=CKPT_THRESHOLD)
+    del input_ids, labels
+    return prod_row, prod2s_row, full_row
+
+
+def lm_head_grad_gate(model, item, device):
+    """Untied head => lm_head.weight.grad IS the head block; must equal
+    unprojected G from compute_prod_features (cos > 0.9999)."""
+    input_ids = torch.tensor(item["input_ids"], device=device).unsqueeze(0)
+    labels = torch.tensor(item["labels"], device=device).unsqueeze(0)
+    with torch.no_grad():
+        out = model(input_ids=input_ids, output_hidden_states=True)
+        G, _, n_sup = compute_prod_features(out.logits, out.hidden_states[-1], labels)
+        del out
+    torch.cuda.empty_cache()
+    out = model(input_ids=input_ids, labels=labels)
+    out.loss.backward()
+    head_grad = model.get_output_embeddings().weight.grad.detach().float()
+    cos = float(torch.sum(G * head_grad) /
+                (G.norm() * head_grad.norm()))
+    rel = float((G - head_grad).norm() / head_grad.norm())
+    model.zero_grad(set_to_none=True)
+    del out, G, head_grad, input_ids, labels
+    torch.cuda.empty_cache()
+    if cos < 0.9999:
+        raise RuntimeError(f"lm_head grad gate FAILED: cos={cos:.8f}, rel={rel:.2e}")
+    return {"cos": cos, "rel_l2": rel, "n_sup": n_sup}
+
+
+def parse_args():
+    ap = argparse.ArgumentParser(
+        description="GSM8K / OLMo-2-1B GRACE features (LESSER paper Table 12, row 2).")
+    ap.add_argument("--out-dir", required=True, help="where the feature pickles are written")
+    ap.add_argument("--data-dir", default=os.path.join(REPO, "data", "gsm8k_synthetic"),
+                    help="GSM8K teacher generations <short>.jsonl (512 prompts x 16 responses)")
+    ap.add_argument("--num-sms", type=int, default=128,
+                    help="SM count pinned for fast_jl (128 = the stored paper features)")
+    return ap.parse_args()
+
+
+def main():
+    args = parse_args()
+    OUT = args.out_dir
+    os.makedirs(OUT, exist_ok=True)
+    device = "cuda"
+    torch.manual_seed(0)
+
+    tokenizer = AutoTokenizer.from_pretrained(STUDENT)
+    model, gradientproj, normalize_factor, grad_dim = build_model(
+        student_pth=STUDENT, device=device, use_lora=False,
+        proj_dim=PROJ_DIM, dtype="auto")
+    model.eval()
+    if model.config.tie_word_embeddings:
+        raise RuntimeError("OLMo-2 student unexpectedly has TIED embeddings")
+    if next(model.parameters()).dtype != torch.float32:
+        raise RuntimeError("student not fp32")
+    print(f"[model] {STUDENT} fp32, grad_dim={grad_dim}, untied OK", flush=True)
+    prod_projector, prod_norm, s_r, s_h = build_prod_projector(model, PROJ_DIM, device)
+    set_projector_num_sms(gradientproj, args.num_sms)
+    set_projector_num_sms(prod_projector, args.num_sms)
+
+    meta_path = os.path.join(OUT, "featurize_meta.json")
+    meta = json.load(open(meta_path)) if os.path.exists(meta_path) else {
+        "student": STUDENT, "proj_dim": PROJ_DIM, "grad_dim": grad_dim,
+        "max_length": MAX_LEN, "ckpt_threshold": CKPT_THRESHOLD,
+        "tie_word_embeddings": False, "teachers": {}}
+
+    for ti, short in enumerate(TEACHERS):
+        full_path = os.path.join(OUT, f"Gradients_{short}.pkl")
+        prod_path = os.path.join(OUT, f"Prod_{short}.pkl")
+        prod2s_path = os.path.join(OUT, f"Prod_{short}_prod2s.pkl")
+        if all(os.path.exists(p) for p in (full_path, prod_path, prod2s_path)):
+            print(f"[skip] {short} done", flush=True)
+            continue
+        t0 = time.time()
+        rows, truncated = build_subset(short, tokenizer, args.data_dir)
+        n = len(rows)
+        assert n == NQ * NGEN
+        print(f"[{short}] subset rebuilt: {n} rows, truncated={truncated}", flush=True)
+
+        tmeta = {"truncated_rows": truncated}
+
+        if ti == 0 or "lm_head_grad_gate" not in meta:
+            g = lm_head_grad_gate(model, rows[0], device)
+            meta["lm_head_grad_gate"] = {"teacher": short, **g}
+            print(f"[gate] lm_head grad exactness: cos={g['cos']:.8f} "
+                  f"rel={g['rel_l2']:.2e}", flush=True)
+
+        # determinism gate
+        det = {}
+        for r in DET_ROWS:
+            a = compute_row(model, rows[r], device, prod_projector, prod_norm,
+                            s_r, s_h, gradientproj, normalize_factor)
+            b = compute_row(model, rows[r], device, prod_projector, prod_norm,
+                            s_r, s_h, gradientproj, normalize_factor)
+            ent = {}
+            for name, x, y in (("prod", a[0], b[0]), ("prod2s", a[1], b[1]),
+                               ("full", a[2], b[2])):
+                x = x.astype(np.float64)
+                y = y.astype(np.float64)
+                cos = float(np.dot(x, y) / (np.linalg.norm(x) * np.linalg.norm(y)))
+                rel = float(np.linalg.norm(x - y) / np.linalg.norm(y))
+                # rel L2 is the primary criterion (rel==0 => bitwise identical);
+                # fp32-accumulated cosine can read 0.99999994 on identical rows.
+                if rel > 1e-6:
+                    raise RuntimeError(
+                        f"{short} determinism gate FAILED row {r} {name}: "
+                        f"cos={cos}, rel={rel}")
+                ent[name] = {"cos": cos, "rel_l2": rel}
+            det[str(r)] = ent
+        tmeta["determinism_gate"] = det
+        print(f"[{short}] determinism gate passed rows {DET_ROWS}", flush=True)
+
+        # resume from partial checkpoint if present
+        part_path = os.path.join(OUT, f"{short}.partial.npz")
+        start = 0
+        prod_arr = np.zeros((n, PROJ_DIM), dtype=np.float32)
+        prod2s_arr = np.zeros((n, 512), dtype=np.float32)
+        full_arr = np.zeros((n, PROJ_DIM), dtype=np.float32)
+        if os.path.exists(part_path):
+            z = np.load(part_path)
+            start = int(z["count"])
+            prod_arr[:start] = z["prod"][:start]
+            prod2s_arr[:start] = z["prod2s"][:start]
+            full_arr[:start] = z["full"][:start]
+            print(f"[{short}] resuming at row {start}", flush=True)
+
+        for i in range(start, n):
+            p, p2, fu = compute_row(model, rows[i], device, prod_projector,
+                                    prod_norm, s_r, s_h, gradientproj,
+                                    normalize_factor)
+            prod_arr[i], prod2s_arr[i], full_arr[i] = p, p2, fu
+            if (i + 1) % 256 == 0 or i == n - 1:
+                np.savez(part_path, count=i + 1, prod=prod_arr,
+                         prod2s=prod2s_arr, full=full_arr)
+                el = time.time() - t0
+                done = i + 1 - start
+                print(f"[{short}] {i+1}/{n} rows, {el:.0f}s "
+                      f"({el/max(done,1):.2f} s/row)", flush=True)
+
+        save_pickle([full_arr[i] for i in range(n)], full_path, "full_grad", n, PROJ_DIM)
+        save_pickle([prod_arr[i] for i in range(n)], prod_path, "prod", n, PROJ_DIM)
+        save_pickle([prod2s_arr[i] for i in range(n)], prod2s_path, "prod2s", n, 512)
+        os.remove(part_path)
+        tmeta["seconds"] = time.time() - t0
+        meta["teachers"][short] = tmeta
+        with open(meta_path, "w") as f:
+            json.dump(meta, f, indent=2)
+        print(f"[{short}] DONE in {tmeta['seconds']:.0f}s", flush=True)
+
+    print("[all done]", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/generate_subset.py b/scripts/generate_subset.py
new file mode 100644
index 0000000000000000000000000000000000000000..7cdf84929417eac0fce988b0879a71d58beb3d07
--- /dev/null
+++ b/scripts/generate_subset.py
@@ -0,0 +1,79 @@
+"""Precompute the deterministic 512-question GSM8K subsample.
+
+Exactly replicates the subsampling in data_generation/tokenize_data.py:
+    rng = random.Random(42); data = data[:]; rng.shuffle(data); data = data[:512]
+over the jsonl order of data/gsm8k/train.jsonl, and writes the selected items
+IN THAT SHUFFLED ORDER to data/gsm8k_512.jsonl.
+
+Why order matters: tokenize_data.py subsamples 4 responses per question with a
+per-question seed 13*example_idx + 13, where example_idx is the position AFTER
+the seed-42 shuffle. Writing the subset in shuffled order means running
+tokenize_data.py on teacher generations over gsm8k_512.jsonl WITHOUT
+--subsample-questions reproduces exactly what the original pipeline (teacher
+generation on all 7473 + --subsample-questions 512) would have produced, while
+generating 512 x 16 instead of 7473 x 16 responses.
+
+IMPORTANT: downstream tokenize_data.py calls must NOT pass --subsample-questions
+(that would re-shuffle the 512-item file with seed 42 and change the per-question
+response-subsample seeds). scripts/run_teacher.sh does this correctly.
+"""
+
+import argparse
+import json
+import os
+import random
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description="Write the deterministic 512-question subsample.")
+    parser.add_argument(
+        "--input-path", type=str,
+        default=os.path.join(REPO_ROOT, "data", "gsm8k", "train.jsonl"),
+    )
+    parser.add_argument(
+        "--output-path", type=str,
+        default=os.path.join(REPO_ROOT, "data", "gsm8k_512.jsonl"),
+    )
+    parser.add_argument("--n-questions", type=int, default=512)
+    parser.add_argument("--seed", type=int, default=42)
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+
+    data = []
+    with open(args.input_path, "r", encoding="utf-8") as f:
+        for line in f:
+            line = line.strip()
+            if line:
+                data.append(json.loads(line))
+    print(f"Loaded {len(data)} items from {args.input_path}")
+    if len(data) < args.n_questions:
+        raise RuntimeError(f"Need at least {args.n_questions} items, got {len(data)}")
+
+    # Exact replication of tokenize_data.py lines 172-176.
+    rng = random.Random(args.seed)
+    data = data[:]
+    rng.shuffle(data)
+    subset = data[: args.n_questions]
+
+    if len(subset) != args.n_questions:
+        raise RuntimeError("Subset size mismatch")
+    for item in subset:
+        if "question" not in item:
+            raise RuntimeError(f"Item missing 'question' key: {sorted(item.keys())}")
+
+    with open(args.output_path, "w", encoding="utf-8") as f:
+        for item in subset:
+            f.write(json.dumps(item, ensure_ascii=False) + "\n")
+
+    idxs = [item.get("idx") for item in subset[:10]]
+    print(f"Wrote {len(subset)} items (shuffled order) to {args.output_path}")
+    print(f"Provenance: seed={args.seed}, first 10 original idx values: {idxs}")
+
+
+if __name__ == "__main__":
+    main()
