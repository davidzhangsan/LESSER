+#!/bin/bash
+# Tokenize the MATH synthetic sets with the STUDENT tokenizer (meta-llama/Llama-3.2-3B).
+# Mirrors run_teacher.sh stage post 1/3: NO --subsample-questions
+# (data/math_512.jsonl is already the seed-42 subsample in shuffled order);
+# --subsample-responses 4 keeps the per-question response seed convention
+# random.Random(13*example_idx + 13) (a reorder when exactly 4 gens exist).
+# Usage: bash scripts/math_tokenize_all.sh <short> [<short> ...]
+# FEAT_PY: python with datasets/transformers (default: .venv/bin/python).
+set -euo pipefail
+cd "$(dirname "${BASH_SOURCE[0]}")/.."
+VENV_PY="${FEAT_PY:-.venv/bin/python}"
+mkdir -p logs_gen
+STUDENT=meta-llama/Llama-3.2-3B
+mkdir -p grace_data/math_synthetic
+for T in "$@"; do
+  IN="data/math_synthetic/${T}.jsonl"
+  OUT="grace_data/math_synthetic/${T}.hf"
+  if [ -d "$OUT" ]; then echo "[tok] skip $T (exists)"; continue; fi
+  if [ ! -s "$IN" ]; then echo "[tok] ERROR: $IN missing" >&2; exit 1; fi
+  echo "[tok] $T ..."
+  TOKENIZERS_PARALLELISM=false $VENV_PY data_generation/tokenize_data.py \
+    --input-path "$IN" \
+    --output-path "$OUT" \
+    --tokenizer-path "$STUDENT" \
+    --subsample-responses 4 \
+    > "logs_gen/math_tok_${T}.log" 2>&1
+  n=$($VENV_PY - "$OUT" <<'EOF'
+import sys
+from datasets import load_from_disk
+d = load_from_disk(sys.argv[1])
+assert len(d) == 2048, f"{len(d)} rows != 2048"
+assert set(["input_ids","labels","question_index","response_index"]).issubset(d.column_names), d.column_names
+print(len(d))
+EOF
+)
+  echo "[tok] $T OK ($n rows)"
+done
+echo "[tok] ALL DONE"
diff --git a/scripts/memory_probe_both.py b/scripts/memory_probe_both.py
new file mode 100644
index 0000000000000000000000000000000000000000..73c68b309803768809f407f7159956cc32bf210d
--- /dev/null
+++ b/scripts/memory_probe_both.py
@@ -0,0 +1,174 @@
+"""Memory probe for the 'both'-mode per-example path (two passes per example to fit 24GB GPUs).
+
+Runs synthetic examples with exactly 2048 supervised shifted tokens (seq_len
+2049, all labels supervised) through the REAL two-pass both-mode path:
+  pass (a) run_prod_pass       — no_grad forward + chunked prod/prod2s features
+  pass (b) run_full_grad_pass  — original fp32 forward + loss.backward()
+on the fp32 student (Llama-3.2-1B), using the same build_model /
+build_prod_projector construction as GRACE/gradient_computation.py.
+
+Gate: torch.cuda.max_memory_allocated() must stay under 20 GiB across all
+iterations. Exit code 0 on PASS, 1 on FAIL.
+
+Also verifies the long-example gradient-checkpointing divergence (see
+gradient_computation.py header): on a T=1024 example it computes the projected
+full-grad row with and without checkpointing forced and requires relative L2
+difference < 1e-4 (10x tighter than the 1e-3 tolerance of scripts/sanity_prod_gate.py).
+The difference is NOT expected to be bitwise zero: checkpoint recompute may
+select different, equally valid fp32 kernels (measured rel L2 ~5e-6).
+
+Run (venv): PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
+    .venv/bin/python scripts/memory_probe_both.py --device cuda:0
+"""
+
+import argparse
+import os
+import sys
+
+import numpy as np
+import torch
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.join(REPO_ROOT, "GRACE"))
+
+from gradient_computation import (  # noqa: E402
+    PROD2S_H_DIM,
+    PROD2S_R_DIM,
+    build_model,
+    build_prod_projector,
+    run_full_grad_pass,
+    run_prod_pass,
+)
+
+LIMIT_GIB = 20.0
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description="Memory probe for the both-mode path.")
+    parser.add_argument("--model", type=str, default="meta-llama/Llama-3.2-1B")
+    parser.add_argument("--device", type=str, default="cuda:0")
+    parser.add_argument(
+        "--n-sup", type=int, default=2048,
+        help="Number of supervised shifted tokens (seq_len = n_sup + 1).",
+    )
+    parser.add_argument("--iters", type=int, default=3)
+    parser.add_argument("--proj-dim", type=int, default=512)
+    parser.add_argument(
+        "--skip-ckpt-equivalence", action="store_true",
+        help="Skip the gradient-checkpointing numeric-equivalence check.",
+    )
+    return parser.parse_args()
+
+
+# Checkpoint recompute may pick different fp32 kernels, so the projected rows
+# differ at fp32 epsilon level (measured ~5e-6 rel L2), never bitwise. 1e-4 is
+# 10x tighter than the 1e-3 fp32 exactness tolerance of sanity_prod_gate.py.
+CKPT_EQUIV_REL_TOL = 1e-4
+
+
+def check_ckpt_equivalence(model, gradientproj, normalize_factor, device, vocab_size):
+    """Projected full-grad row must be fp32-machine-precision identical with and
+    without gradient checkpointing (the long-example path)."""
+    gen = torch.Generator(device="cpu")
+    gen.manual_seed(1)
+    seq_len = 1024
+    input_ids = torch.randint(0, vocab_size, (1, seq_len), generator=gen).to(device)
+    labels = input_ids.clone()
+
+    row_plain = run_full_grad_pass(
+        model, input_ids, labels, False, gradientproj, normalize_factor
+    )
+    row_ckpt = run_full_grad_pass(
+        model, input_ids, labels, False, gradientproj, normalize_factor,
+        ckpt_threshold=0,  # force the checkpointed path
+    )
+    denom = float(np.linalg.norm(row_plain))
+    if denom == 0.0:
+        raise RuntimeError("ckpt-equivalence: plain row has zero norm; degenerate probe.")
+    rel = float(np.linalg.norm(row_ckpt - row_plain)) / denom
+    print(f"ckpt-equivalence (T={seq_len}): rel L2 diff = {rel:.3e} (tol {CKPT_EQUIV_REL_TOL:.0e})")
+    if rel >= CKPT_EQUIV_REL_TOL:
+        raise RuntimeError(
+            f"ckpt-equivalence FAILED: rel L2 diff {rel:.3e} >= {CKPT_EQUIV_REL_TOL:.0e}"
+        )
+    del input_ids, labels
+    torch.cuda.empty_cache()
+
+
+def main():
+    args = parse_args()
+    device = torch.device(args.device)
+    if device.type != "cuda":
+        raise ValueError("Memory probe requires a CUDA device.")
+    # fast_jl launches kernels on the CURRENT device; with tensors on cuda:N and
+    # current device cuda:0 it hits an illegal memory access. The pipeline always
+    # runs under CUDA_VISIBLE_DEVICES (so cuda:0); make the probe match any --device.
+    torch.cuda.set_device(device)
+
+    print(f"Loading fp32 student from: {args.model} on {args.device}")
+    model, gradientproj, normalize_factor, grad_dim = build_model(
+        student_pth=args.model,
+        device=args.device,
+        use_lora=False,
+        proj_dim=args.proj_dim,
+        dtype="float32",
+    )
+    model.train(False)
+    print(f"full grad_dim: {grad_dim}")
+
+    param_dtypes = {p.dtype for p in model.parameters()}
+    if param_dtypes != {torch.float32}:
+        raise RuntimeError(f"fp32 protocol violated: param dtypes {param_dtypes}")
+
+    prod_projector, prod_normalize_factor, s_r, s_h = build_prod_projector(
+        model, args.proj_dim, device
+    )
+
+    vocab_size = model.get_output_embeddings().weight.shape[0]
+
+    if not args.skip_ckpt_equivalence:
+        check_ckpt_equivalence(model, gradientproj, normalize_factor, device, vocab_size)
+
+    seq_len = args.n_sup + 1  # HF shift: seq_len-1 supervised positions
+    gen = torch.Generator(device="cpu")
+    gen.manual_seed(0)
+    input_ids = torch.randint(0, vocab_size, (1, seq_len), generator=gen).to(device)
+    labels = input_ids.clone()
+
+    torch.cuda.synchronize(device)
+    torch.cuda.reset_peak_memory_stats(device)
+    base_gib = torch.cuda.memory_allocated(device) / 2**30
+    print(f"baseline allocated (model + projectors): {base_gib:.2f} GiB")
+    print(f"synthetic example: seq_len={seq_len}, n_sup={args.n_sup}")
+
+    for it in range(args.iters):
+        prod_row, prod2s_row = run_prod_pass(
+            model, input_ids, labels, prod_projector, prod_normalize_factor, s_r, s_h
+        )
+        full_row = run_full_grad_pass(
+            model, input_ids, labels, False, gradientproj, normalize_factor
+        )
+
+        # The probe must exercise the real path end-to-end, not just not-crash.
+        if prod_row.shape != (args.proj_dim,) or not np.isfinite(prod_row).all():
+            raise RuntimeError(f"prod row bad: shape={prod_row.shape}")
+        if prod2s_row.shape != (PROD2S_R_DIM * PROD2S_H_DIM,) or not np.isfinite(prod2s_row).all():
+            raise RuntimeError(f"prod2s row bad: shape={prod2s_row.shape}")
+        if full_row.shape != (args.proj_dim,) or not np.isfinite(full_row).all():
+            raise RuntimeError(f"full-grad row bad: shape={full_row.shape}")
+
+        torch.cuda.synchronize(device)
+        peak_gib = torch.cuda.max_memory_allocated(device) / 2**30
+        print(f"iter {it}: peak allocated so far = {peak_gib:.2f} GiB")
+
+    peak_gib = torch.cuda.max_memory_allocated(device) / 2**30
+    print(f"\nFINAL peak allocated: {peak_gib:.2f} GiB (limit {LIMIT_GIB:.1f} GiB)")
+    if peak_gib >= LIMIT_GIB:
+        print("MEMORY PROBE FAIL")
+        sys.exit(1)
+    print("MEMORY PROBE PASS")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/run_teacher.sh b/scripts/run_teacher.sh
new file mode 100755
index 0000000000000000000000000000000000000000..ff22b8c75280d7409f3aff16a531bdf2218864f8
--- /dev/null
+++ b/scripts/run_teacher.sh
@@ -0,0 +1,169 @@
+#!/usr/bin/env bash
+# Forward-GRACE teacher pipeline.
+# Produces the GSM8K / Llama-3.2-1B features and scores behind LESSER paper Table 12, row 1.
+#
+# Usage: bash scripts/run_teacher.sh <teacher_hf_id> <short_name> <gpu_index> [stage]
+#   stage: all  (default) = gen + post
+#          gen             = vLLM teacher generation only
+#          post            = tokenize -> gradients (--feature both) -> GRACE scores
+#
+# Environment (interpreters are configurable, defaults below):
+#   GEN_PY          python with vLLM, used for generation only (default: python).
+#                   The paper runs used vllm 0.11.0 for the original ten teachers.
+#   FEAT_PY         python for tokenize/gradients/scoring (default: $REPO/.venv/bin/python,
+#                   built by scripts/setup_venv.sh: torch 2.6.0, transformers 4.51.1,
+#                   traker 0.3.2, fast-jl 0.1.3 built from source).
+#   NUM_SMS         SM count pinned for fast_jl (default 128, the value behind the stored
+#                   paper features; see the header of GRACE/gradient_computation.py).
+#   GEN_EXTRA_ARGS  extra generate_responses.py arguments, e.g. the vLLM memory caps
+#                   "--max_model_len 8192 --max_num_seqs 64" (default: none).
+#
+# Pipeline notes:
+#   - Generation runs on data/gsm8k_512.jsonl (the deterministic seed-42 subsample in
+#     shuffled order; see scripts/generate_subset.py), n=16 responses, temp 0.6,
+#     max_tokens 4096, the repo's chat-template prompt with the boxed instruction.
+#   - tokenize_data.py intentionally does NOT pass --subsample-questions (the 512-file
+#     is already the subsample in the order tokenize_data would have produced); it DOES
+#     pass --subsample-responses 4 so per-question response picks match the original
+#     seeds 13*idx+13.
+#   - gradient_computation.py --feature both writes three pickles with identical row
+#     order: full-grad, prod, prod2s. GRACE_computation.py is feature-agnostic and is
+#     run on each; scores are appended to results_grace/scores.jsonl.
+#   - The student is loaded in float32 explicitly. The paper runs used the default
+#     --dtype auto, which is float32 under transformers 4.51.1; newer transformers
+#     releases may resolve auto to the bf16 checkpoint dtype instead.
+
+set -euo pipefail
+
+if [[ $# -lt 3 ]]; then
+    echo "Usage: bash scripts/run_teacher.sh <teacher_hf_id> <short_name> <gpu_index> [all|gen|post]" >&2
+    exit 1
+fi
+
+TEACHER="$1"
+SHORT="$2"
+GPU="$3"
+STAGE="${4:-all}"
+
+REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$REPO"
+
+GEN_PY="${GEN_PY:-python}"
+FEAT_PY="${FEAT_PY:-$REPO/.venv/bin/python}"
+NUM_SMS="${NUM_SMS:-128}"
+GEN_EXTRA_ARGS="${GEN_EXTRA_ARGS:-}"
+
+STUDENT=meta-llama/Llama-3.2-1B
+PROJ_DIM=512
+N_GEN_PER_PROMPT=4
+
+SUBSET=data/gsm8k_512.jsonl
+SYN=data/gsm8k_synthetic/${SHORT}.jsonl
+HF_DATA=grace_data/gsm8k_synthetic/${SHORT}.hf
+FULL_PKL=grace_data/gsm8k_synthetic/Gradients_${SHORT}.pkl
+PROD_PKL=grace_data/gsm8k_synthetic/Prod_${SHORT}.pkl
+PROD2S_PKL=grace_data/gsm8k_synthetic/Prod_${SHORT}_prod2s.pkl
+SCORES=results_grace/scores.jsonl
+
+mkdir -p data/gsm8k_synthetic grace_data/gsm8k_synthetic results_grace logs_gen
+
+export CUDA_VISIBLE_DEVICES="$GPU"
+export NCCL_P2P_DISABLE=1
+export NCCL_IB_DISABLE=1
+export TOKENIZERS_PARALLELISM=false
+
+echo "[run_teacher] teacher=$TEACHER short=$SHORT gpu=$GPU stage=$STAGE"
+
+if [[ "$STAGE" == "all" || "$STAGE" == "gen" ]]; then
+    if [[ ! -f "$SUBSET" ]]; then
+        echo "[run_teacher] ERROR: $SUBSET missing; run scripts/generate_subset.py first." >&2
+        exit 1
+    fi
+    echo "[run_teacher] === Stage gen: vLLM generation ($TEACHER) ==="
+    # shellcheck disable=SC2086  # GEN_EXTRA_ARGS is a list of CLI arguments
+    "$GEN_PY" data_generation/generate_responses.py \
+        --model_path "$TEACHER" \
+        --input_file "$SUBSET" \
+        --output_file "$SYN" \
+        --temperature 0.6 \
+        --top_p 1.0 \
+        --max_tokens 4096 \
+        --responses_per_question 16 \
+        --tensor_parallel_size 1 \
+        --gpu_memory_utilization 0.85 \
+        $GEN_EXTRA_ARGS
+        # 0.85 not 0.9: vLLM 0.11 sampler warmup (256 dummy seqs, vocab sort) OOMs
+        # at 0.9 on a 24GB RTX 4090 (observed with Qwen2.5-Math-1.5B-Instruct).
+fi
+
+if [[ "$STAGE" == "all" || "$STAGE" == "post" ]]; then
+    if [[ ! -f "$SYN" ]]; then
+        echo "[run_teacher] ERROR: $SYN missing; run the gen stage first." >&2
+        exit 1
+    fi
+    if ! command -v "$FEAT_PY" > /dev/null; then
+        echo "[run_teacher] ERROR: FEAT_PY=$FEAT_PY not found; run scripts/setup_venv.sh or set FEAT_PY." >&2
+        exit 1
+    fi
+
+    # Fp32 full-grad backward + prod pass fragment the allocator on 24GB cards;
+    # expandable segments avoid the reserved-but-unallocated OOMs.
+    export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
+
+    echo "[run_teacher] === Stage post 1/3: tokenize ==="
+    # NOTE: deliberately NO --subsample-questions (see header).
+    "$FEAT_PY" data_generation/tokenize_data.py \
+        --input-path "$SYN" \
+        --output-path "$HF_DATA" \
+        --tokenizer-path "$STUDENT" \
+        --subsample-responses "$N_GEN_PER_PROMPT"
+
+    echo "[run_teacher] === Stage post 2/3: gradients + prod features ==="
+    "$FEAT_PY" GRACE/gradient_computation.py \
+        --model "$STUDENT" \
+        --data-path "$HF_DATA" \
+        --output-path "$FULL_PKL" \
+        --feature both \
+        --prod-output-path "$PROD_PKL" \
+        --proj-dim "$PROJ_DIM" \
+        --dtype float32 \
+        --num-sms "$NUM_SMS" \
+        --device cuda
+
+    echo "[run_teacher] === Stage post 3/3: GRACE scores ==="
+    score_of () {
+        local pkl="$1"
+        "$FEAT_PY" GRACE/GRACE_computation.py \
+            --gradients-path "$pkl" \
+            --dim "$PROJ_DIM" \
+            --n-gen-per-prompt "$N_GEN_PER_PROMPT" \
+            | tee /dev/stderr | grep "GRACE score:" | awk '{print $3}'
+    }
+    grace_full=$(score_of "$FULL_PKL")
+    grace_prod=$(score_of "$PROD_PKL")
+    grace_prod2s=$(score_of "$PROD2S_PKL")
+
+    for v in grace_full grace_prod grace_prod2s; do
+        if [[ -z "${!v}" ]]; then
+            echo "[run_teacher] ERROR: $v is empty; scoring failed." >&2
+            exit 1
+        fi
+    done
+
+    TEACHER="$TEACHER" SHORT="$SHORT" GF="$grace_full" GP="$grace_prod" GP2="$grace_prod2s" SCORES="$SCORES" \
+    "$FEAT_PY" - <<'EOF'
+import json, os
+row = {
+    "teacher": os.environ["TEACHER"],
+    "short": os.environ["SHORT"],
+    "grace_full": float(os.environ["GF"]),
+    "grace_prod": float(os.environ["GP"]),
+    "grace_prod2s": float(os.environ["GP2"]),
+}
+with open(os.environ["SCORES"], "a", encoding="utf-8") as f:
+    f.write(json.dumps(row) + "\n")
+print("[run_teacher] appended:", row)
+EOF
+fi
+
+echo "[run_teacher] done: $SHORT ($STAGE)"
diff --git a/scripts/sanity_prod_gate.py b/scripts/sanity_prod_gate.py
new file mode 100644
index 0000000000000000000000000000000000000000..f65e76755020c4b207ee0cf19147dadd9d42b6f4
--- /dev/null
+++ b/scripts/sanity_prod_gate.py
@@ -0,0 +1,165 @@
+"""Exactness gate for the forward-GRACE 'prod' feature.
+
+Checks, on 5 short GSM8K examples with the student model (Llama-3.2-1B), that the
+forward-computed G = (1/n_sup) * R^T H from GRACE/gradient_computation.py's
+compute_prod_G equals the autograd gradient of the HF mean-CE loss w.r.t.
+lm_head.weight.
+
+CAVEAT handled here: Llama-3.2-1B TIES input and output embeddings
+(tie_word_embeddings=True), so param-level autograd of the shared matrix would
+include the input-embedding term. We therefore compute the autograd reference on
+a FRESH UNTIED copy: model.get_output_embeddings() is replaced by a cloned
+nn.Linear so lm_head.weight is a distinct leaf whose .grad contains ONLY the
+head term. This also validates HF's shift/mask/mean-reduction conventions
+against ours, since the loss is still computed by the HF model path.
+
+The model is loaded in float32 so the comparison is a genuine exactness test
+(bf16 forward noise would swamp the 1e-3 gate).
+
+Gate: relative Frobenius error ||G - grad||_F / ||grad||_F < 1e-3 on all 5
+examples. Exit code 0 on PASS, 1 on FAIL.
+
+Run (venv): .venv/bin/python scripts/sanity_prod_gate.py --device cuda:0
+"""
+
+import argparse
+import json
+import os
+import sys
+
+import torch
+import torch.nn as nn
+from transformers import AutoModelForCausalLM, AutoTokenizer
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.join(REPO_ROOT, "GRACE"))
+sys.path.insert(0, os.path.join(REPO_ROOT, "data_generation"))
+
+from gradient_computation import compute_prod_G  # noqa: E402
+from tokenize_data import build_example  # noqa: E402
+
+GATE_REL_ERR = 1e-3
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description="Exactness gate for the prod feature.")
+    parser.add_argument("--model", type=str, default="meta-llama/Llama-3.2-1B")
+    parser.add_argument("--device", type=str, default="cuda:0")
+    parser.add_argument(
+        "--data-path",
+        type=str,
+        default=os.path.join(REPO_ROOT, "data", "gsm8k", "train.jsonl"),
+    )
+    parser.add_argument("--n-examples", type=int, default=5)
+    return parser.parse_args()
+
+
+def load_short_examples(path: str, n: int):
+    """Take the n shortest (question+answer) items from the jsonl for a fast fp32 gate."""
+    items = []
+    with open(path, "r", encoding="utf-8") as f:
+        for line in f:
+            line = line.strip()
+            if line:
+                items.append(json.loads(line))
+    if len(items) < n:
+        raise RuntimeError(f"Only {len(items)} items in {path}, need {n}")
+    items.sort(key=lambda x: len(x["question"]) + len(x["answer"]))
+    return items[:n]
+
+
+def untie_lm_head(model: nn.Module) -> nn.Module:
+    """Replace the (tied) output embedding with a cloned nn.Linear leaf."""
+    old = model.get_output_embeddings()
+    if old is None:
+        raise RuntimeError("Model has no output embeddings; cannot untie.")
+    new = nn.Linear(old.in_features, old.out_features, bias=False)
+    new.weight = nn.Parameter(old.weight.detach().clone())
+    new = new.to(device=old.weight.device, dtype=old.weight.dtype)
+    model.set_output_embeddings(new)
+    model.config.tie_word_embeddings = False
+
+    in_ptr = model.get_input_embeddings().weight.data_ptr()
+    out_ptr = model.get_output_embeddings().weight.data_ptr()
+    if in_ptr == out_ptr:
+        raise RuntimeError("Untying failed: input and output embeddings still share storage.")
+    return model
+
+
+def main():
+    args = parse_args()
+    device = torch.device(args.device)
+
+    print(f"Loading tokenizer + model (float32) from: {args.model}")
+    tokenizer = AutoTokenizer.from_pretrained(args.model)
+    model = AutoModelForCausalLM.from_pretrained(args.model, torch_dtype=torch.float32)
+    model = model.to(device)
+    model = untie_lm_head(model)
+    model.train(False)
+
+    tied_check = model.get_output_embeddings().weight
+    print(f"Untied lm_head: shape={tuple(tied_check.shape)}, dtype={tied_check.dtype}")
+
+    examples = load_short_examples(args.data_path, args.n_examples)
+
+    rows = []
+    all_pass = True
+    for i, ex in enumerate(examples):
+        item = build_example(
+            problem=ex["question"],
+            solution=ex["answer"],
+            tokenizer=tokenizer,
+            ignore_index=-100,
+            max_length=None,
+        )
+        input_ids = torch.tensor(item["input_ids"], device=device).unsqueeze(0)
+        labels = torch.tensor(item["labels"], device=device).unsqueeze(0)
+        n_sup = int((labels != -100).sum().item())
+
+        model.zero_grad(set_to_none=True)
+        outputs = model(input_ids=input_ids, labels=labels, output_hidden_states=True)
+        outputs.loss.backward()
+
+        grad_ref = model.get_output_embeddings().weight.grad
+        if grad_ref is None:
+            raise RuntimeError("Autograd reference is None; lm_head is not a leaf with grad.")
+        grad_ref = grad_ref.detach().float()
+
+        # Sanity: input-embedding grad must be a SEPARATE tensor (untied worked).
+        emb_grad = model.get_input_embeddings().weight.grad
+        if emb_grad is None:
+            raise RuntimeError("Input embedding got no grad; forward graph looks wrong.")
+        if emb_grad.data_ptr() == grad_ref.data_ptr():
+            raise RuntimeError("Input and output embedding grads share storage; untying failed.")
+
+        G = compute_prod_G(
+            outputs.logits.detach(),
+            outputs.hidden_states[-1].detach(),
+            labels,
+        )
+
+        ref_norm = grad_ref.norm().item()
+        if ref_norm == 0.0:
+            raise RuntimeError("Autograd reference has zero norm; degenerate example.")
+        rel_err = (G - grad_ref).norm().item() / ref_norm
+        ok = rel_err < GATE_REL_ERR
+        all_pass = all_pass and ok
+        rows.append((i, input_ids.shape[1], n_sup, outputs.loss.item(), rel_err, ok))
+
+        del outputs, G, grad_ref
+        model.zero_grad(set_to_none=True)
+
+    print()
+    print(f"{'ex':>3} {'T':>5} {'n_sup':>6} {'loss':>10} {'rel_frob_err':>14} {'pass':>6}")
+    for i, t, n_sup, loss, rel_err, ok in rows:
+        print(f"{i:>3} {t:>5} {n_sup:>6} {loss:>10.4f} {rel_err:>14.3e} {str(ok):>6}")
+    print()
+    if all_pass:
+        print(f"GATE PASS: all {len(rows)} examples have rel Frobenius error < {GATE_REL_ERR}")
+        sys.exit(0)
+    print(f"GATE FAIL: at least one example has rel Frobenius error >= {GATE_REL_ERR}")
+    sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/setup_venv.sh b/scripts/setup_venv.sh
new file mode 100755
index 0000000000000000000000000000000000000000..f92df0bcfe4edf020fec47027a6d76df5e5d67e2
--- /dev/null
+++ b/scripts/setup_venv.sh
@@ -0,0 +1,106 @@
+#!/usr/bin/env bash
+# Reproducible env setup for the patched GRACE pipeline.
+#
+# WHY THIS EXISTS:
+#   Gradient extraction needs trak's CudaProjector with the fast_jl CUDA extension,
+#   which has to be built from source. So gradient/GRACE steps run in a dedicated
+#   venv at .venv with grace.yml pins where feasible.
+#
+# DIVERGENCES FROM grace.yml (with rationale):
+#   - python 3.11 (from a conda installation) instead of 3.10: a system python3.10
+#     often lacks ensurepip, and grace.yml's remaining pins all support 3.11.
+#   - vllm is NOT installed here: teacher generation runs in a separate environment
+#     with vLLM (vllm 0.11.0 for the paper runs; scripts/run_teacher.sh stage `gen`).
+#     fast_jl is not needed for generation.
+#   - flash-attn is NOT installed (not needed for batch-size-1 gradient extraction).
+#   - fast-jl 0.1.3 is built from a patched sdist: TORCH_CUDA_ARCH_LIST 7.0+PTX -> 8.9
+#     (native RTX 4090; set FAST_JL_CUDA_ARCH for other GPUs, e.g. 8.0 for A100 or
+#     9.0 for H100) and torch's -D__CUDA_NO_HALF_* defines dropped from
+#     COMMON_NVCC_FLAGS. Built against a self-contained CUDA 12.4.131 toolchain at
+#     .cuda124 (conda prefix env; an nvcc 12.9 failed to compile fast_jl with its CCCL
+#     headers, and torch 2.6.0 wheels are cu124).
+#   - Math-library headers (cusparse/cublas/...) come from the pip nvidia-*-cu12 wheels
+#     already pulled in by torch 2.6.0+cu124, exposed via CPATH at build time only.
+#
+# NOTE: fast_jl accepts only fp16/fp32 inputs. The repo's default --dtype auto loads
+# the student in fp32, so both the full-grad and prod paths feed fp32.
+#
+# Machine-specific paths are environment variables.
+#   CONDA_BASE         conda installation that provides python3.11 and the CUDA 12.4
+#                      toolchain packages (default: `conda info --base`).
+#   PYTHON311          interpreter for the venv (default: $CONDA_BASE/bin/python3.11).
+#   FAST_JL_CUDA_ARCH  TORCH_CUDA_ARCH_LIST used to build fast_jl (default: 8.9).
+
+set -euo pipefail
+REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$REPO"
+
+CONDA_BASE="${CONDA_BASE:-$(conda info --base)}"
+PYTHON311="${PYTHON311:-$CONDA_BASE/bin/python3.11}"
+export FAST_JL_CUDA_ARCH="${FAST_JL_CUDA_ARCH:-8.9}"
+
+# 1) venv + pinned python deps
+"$PYTHON311" -m venv .venv
+.venv/bin/python -m pip install --upgrade pip
+.venv/bin/pip install torch==2.6.0 --index-url https://download.pytorch.org/whl/cu124
+.venv/bin/pip install numpy==2.2.6 transformers==4.51.1 datasets==4.1.1 \
+    accelerate==1.10.1 tokenizers==0.21.4 safetensors sentencepiece tqdm \
+    traker==0.3.2 wheel setuptools ninja
+
+# 2) self-contained CUDA 12.4 toolchain in a conda prefix inside the checkout
+"$CONDA_BASE/bin/conda" create -y -p "$REPO/.cuda124" \
+    -c "nvidia/label/cuda-12.4.1" cuda-nvcc cuda-cudart-dev cuda-cccl
+
+# 3) fast-jl 0.1.3 from patched sdist
+BUILD="$(mktemp -d)"
+mkdir -p "$BUILD" && cd "$BUILD"
+curl -sLO https://files.pythonhosted.org/packages/b3/89/c3251ac89c2d79dbb5bbc64817d6d9349feddfbc4f2d78147f823f9881bc/fast_jl-0.1.3.tar.gz
+tar xzf fast_jl-0.1.3.tar.gz
+cd fast_jl-0.1.3
+"$REPO/.venv/bin/python" - <<'EOF'
+import os
+content = open('setup.py').read()
+old = """environ['TORCH_CUDA_ARCH_LIST']="7.0+PTX"
+
+from setuptools import setup
+from torch.utils.cpp_extension import BuildExtension, CUDAExtension"""
+new = """environ['TORCH_CUDA_ARCH_LIST'] = "@FAST_JL_CUDA_ARCH@"
+
+from setuptools import setup
+# nvcc CCCL headers break with torch's -D__CUDA_NO_HALF_* defines here; fast_jl
+# does not rely on implicit half conversions, so drop the defines.
+import torch.utils.cpp_extension as _cpp_ext
+_cpp_ext.COMMON_NVCC_FLAGS = [
+    f for f in _cpp_ext.COMMON_NVCC_FLAGS if not f.startswith('-D__CUDA_NO_')
+]
+from torch.utils.cpp_extension import BuildExtension, CUDAExtension"""
+assert old in content, "fast_jl setup.py changed upstream; re-derive the patch"
+new = new.replace("@FAST_JL_CUDA_ARCH@", os.environ["FAST_JL_CUDA_ARCH"])
+open('setup.py','w').write(content.replace(old, new))
+print("patched setup.py")
+EOF
+
+export CUDA_HOME="$REPO/.cuda124"
+export PATH="$CUDA_HOME/bin:$PATH"
+SP="$REPO/.venv/lib/python3.11/site-packages/nvidia"
+export CPATH="$SP/cusparse/include:$SP/cublas/include:$SP/cusolver/include:$SP/curand/include:$SP/cufft/include:$SP/cudnn/include:$SP/nvtx/include:$SP/nccl/include"
+export MAX_JOBS=8
+"$REPO/.venv/bin/pip" install . --no-build-isolation
+
+# 4) smoke test at the real dims used by the pipeline
+cd "$REPO"
+.venv/bin/python - <<'EOF'
+import torch
+from trak.projectors import CudaProjector, ProjectionType
+for grad_dim in (262668288, 1235814400):  # prod V*d and full-model Llama-3.2-1B
+    p = CudaProjector(grad_dim=grad_dim, proj_dim=512, seed=0,
+                      proj_type=ProjectionType.rademacher, device="cuda:0",
+                      dtype=torch.bfloat16, block_size=4, max_batch_size=8)
+    x = torch.randn(1, grad_dim, device="cuda:0", dtype=torch.float32)
+    y = p.project(x, model_id=0)
+    assert y.shape == (1, 512) and torch.isfinite(y.float()).all()
+    print(f"grad_dim={grad_dim}: projection OK")
+    del p, x, y
+    torch.cuda.empty_cache()
+EOF
+echo "setup_venv.sh: done"
